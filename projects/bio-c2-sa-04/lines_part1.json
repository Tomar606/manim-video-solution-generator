[
 {
  "start": 0.0,
  "end": 1.56,
  "text": "MP Board कक्षा"
 },
 {
  "start": 1.56,
  "end": 2.4,
  "text": "बारहवीं के बच्चों,"
 },
 {
  "start": 2.4,
  "end": 4.5,
  "text": "पूरे तीन नंबर का ये सवाल,"
 },
 {
  "start": 4.5,
  "end": 5.3,
  "text": "2020 में board exam"
 },
 {
  "start": 5.3,
  "end": 6.26,
  "text": "में पूछा गया है,"
 },
 {
  "start": 6.26,
  "end": 7.14,
  "text": "और इस साल भी आपकी"
 },
 {
  "start": 7.14,
  "end": 8.42,
  "text": "परीक्षा में आ सकता है।"
 },
 {
  "start": 8.42,
  "end": 9.34,
  "text": "तो बच्चों, जैसा"
 },
 {
  "start": 9.34,
  "end": 11.22,
  "text": "मैं आपको समझाऊँगा,"
 },
 {
  "start": 11.22,
  "end": 12.67,
  "text": "exam में बिल्कुल वैसा ही"
 },
 {
  "start": 12.67,
  "end": 14.422,
  "text": "लिखना, तभी पूरे नंबर मिलेंगे।"
 },
 {
  "start": 14.422,
  "end": 15.63,
  "text": "सबसे पहले देखते हैं,"
 },
 {
  "start": 15.63,
  "end": 17.33,
  "text": "कि प्रसव यानी"
 },
 {
  "start": 17.33,
  "end": 18.49,
  "text": "parturition क्या होता है।"
 },
 {
  "start": 18.49,
  "end": 21.55,
  "text": "गर्भ की अवधि पूरी हो जाने पर,"
 },
 {
  "start": 21.55,
  "end": 22.35,
  "text": "गर्भाशयी भित्ति में होने"
 },
 {
  "start": 22.35,
  "end": 24.55,
  "text": "वाले तीव्र संकुचनों के कारण,"
 },
 {
  "start": 24.55,
  "end": 27.51,
  "text": "शिशु का योनिमार्ग से बाहर आना,"
 },
 {
  "start": 27.51,
  "end": 29.26,
  "text": "प्रसव या parturition"
 },
 {
  "start": 29.26,
  "end": 30.06,
  "text": "कहलाता है।"
 },
 {
  "start": 30.06,
  "end": 31.82,
  "text": "यानी बच्चों, जब pregnancy"
 },
 {
  "start": 31.82,
  "end": 33.36,
  "text": "की पूरी अवधि हो जाती है,"
 },
 {
  "start": 33.36,
  "end": 35.4,
  "text": "तो uterus में तीव्र"
 },
 {
  "start": 35.4,
  "end": 36.56,
  "text": "संकुचन शुरू होते हैं,"
 },
 {
  "start": 36.56,
  "end": 38.34,
  "text": "और इन्हीं संकुचनों की मदद से,"
 },
 {
  "start": 38.34,
  "end": 40.78,
  "text": "शिशु जन्म नाल से बाहर आता है।"
 },
 {
  "start": 40.78,
  "end": 42.18,
  "text": "इसी पूरी प्रक्रिया"
 },
 {
  "start": 42.18,
  "end": 43.64,
  "text": "को प्रसव कहते हैं।"
 },
 {
  "start": 43.64,
  "end": 44.82,
  "text": "अब ध्यान से सुनो,"
 },
 {
  "start": 44.82,
  "end": 46.5,
  "text": "प्रसव अचानक होने वाली"
 },
 {
  "start": 46.5,
  "end": 48.32,
  "text": "simple process नहीं है।"
 },
 {
  "start": 48.32,
  "end": 49.513,
  "text": "यह एक जटिल तंत्रिका"
 },
 {
  "start": 49.513,
  "end": 51.02,
  "text": "अंतःस्रावी प्रक्रिया है,"
 },
 {
  "start": 51.02,
  "end": 52.26,
  "text": "यानी इसमें तंत्रिका"
 },
 {
  "start": 52.26,
  "end": 54.48,
  "text": "तंत्र और इसलिए,"
 },
 {
  "start": 54.48,
  "end": 55.66,
  "text": "स्रावी तंत्र दोनों तरह के"
 },
 {
  "start": 55.66,
  "end": 57.94,
  "text": "signals की भूमिका होती है।"
 },
 {
  "start": 57.94,
  "end": 59.92,
  "text": "पूर्ण विकसित शिशु और"
 },
 {
  "start": 59.92,
  "end": 62.48,
  "text": "अपरा से मिलने वाले संकेत,"
 },
 {
  "start": 62.48,
  "end": 63.46,
  "text": "इस प्रक्रिया को शुरू करने"
 },
 {
  "start": 63.46,
  "end": 65.589,
  "text": "में महत्वपूर्ण होते हैं।"
 },
 {
  "start": 65.589,
  "end": 66.92,
  "text": "अब आते हैं सबसे"
 },
 {
  "start": 66.92,
  "end": 67.78,
  "text": "important हिस्से पर,"
 },
 {
  "start": 67.78,
  "end": 69.08,
  "text": "प्रसव को प्रेरित"
 },
 {
  "start": 69.08,
  "end": 70.78,
  "text": "करने वाले hormones।"
 },
 {
  "start": 70.78,
  "end": 72.12,
  "text": "और यहाँ मुख्य रूप"
 },
 {
  "start": 72.12,
  "end": 73.258,
  "text": "से दो hormones"
 },
 {
  "start": 73.258,
  "end": 74.314,
  "text": "याद रखने हैं,"
 },
 {
  "start": 74.314,
  "end": 75.94,
  "text": "Oxytocin और Relaxin।"
 },
 {
  "start": 75.94,
  "end": 77.18,
  "text": "सबसे पहले देखते"
 },
 {
  "start": 77.18,
  "end": 78.54,
  "text": "हैं, Oxytocin को।"
 },
 {
  "start": 78.54,
  "end": 80.38,
  "text": "इसमें, माँ की posterior"
 },
 {
  "start": 80.38,
  "end": 81.5,
  "text": "pituitary यानी"
 },
 {
  "start": 81.5,
  "end": 82.86,
  "text": "पश्च पियूष ग्रंथि"
 },
 {
  "start": 82.86,
  "end": 83.76,
  "text": "से release होता है,"
 },
 {
  "start": 83.76,
  "end": 86.72,
  "text": "और गर्भाशय की smooth muscles"
 },
 {
  "start": 86.72,
  "end": 87.72,
  "text": "में contractions को बढ़ाता है।"
 },
 {
  "start": 87.72,
  "end": 90.16,
  "text": "और बच्चों, जैसे-जैसे"
 },
 {
  "start": 90.16,
  "end": 91.269,
  "text": "गर्भाशयी संकुचन बढ़ते हैं,"
 },
 {
  "start": 91.269,
  "end": 92.08,
  "text": "oxytocin का release"
 },
 {
  "start": 92.08,
  "end": 93.07,
  "text": "भी बढ़ता है।"
 },
 {
  "start": 93.07,
  "end": 94.72,
  "text": "इससे contractions और"
 },
 {
  "start": 94.72,
  "end": 95.68,
  "text": "strong होते जाते हैं,"
 },
 {
  "start": 95.68,
  "end": 97.6,
  "text": "और आखिरकार baby birth"
 },
 {
  "start": 97.6,
  "end": 99.66,
  "text": "canal से बाहर आ जाता है।"
 },
 {
  "start": 99.66,
  "end": 102.1,
  "text": "इसलिए ये दिमाग में बैठा लो,"
 },
 {
  "start": 102.1,
  "end": 102.94,
  "text": "Oxytocin गर्भाशय के"
 },
 {
  "start": 102.94,
  "end": 104.86,
  "text": "संकुचन में मदद करता है,"
 },
 {
  "start": 104.86,
  "end": 106.42,
  "text": "और प्रसव की प्रक्रिया"
 },
 {
  "start": 106.42,
  "end": 107.9,
  "text": "को आगे बढ़ाता है।"
 },
 {
  "start": 107.9,
  "end": 109.14,
  "text": "बच्चों, पहला तो हो गया,"
 },
 {
  "start": 109.14,
  "end": 110.42,
  "text": "लेकिन अभी एक और"
 },
 {
  "start": 110.42,
  "end": 111.8,
  "text": "hormone बाकी है।"
 },
 {
  "start": 111.8,
  "end": 113.16,
  "text": "तो चलो, उसे Part"
 },
 {
  "start": 113.16,
  "end": 114.08,
  "text": "two में समझेंगे,"
 },
 {
  "start": 114.08,
  "end": 115.68,
  "text": "और पूरे 3 नंबर की"
 },
 {
  "start": 115.68,
  "end": 117.13,
  "text": "तैयारी भी पक्की करेंगे।"
 }
]