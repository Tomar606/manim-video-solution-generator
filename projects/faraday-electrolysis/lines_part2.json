[
  {
    "start": 0.0,
    "text": "बच्चों, पार्ट 1 में हमने समझा"
  },
  {
    "start": 2.2,
    "text": "फैराडे का पहला नियम"
  },
  {
    "start": 3.54,
    "text": "और अब समझते हैं फैराडे का"
  },
  {
    "start": 5.6,
    "text": "दूसरा नियम क्या कहता है"
  },
  {
    "start": 7.32,
    "text": "तो बच्चों, जैसे पहला नियम याद किया"
  },
  {
    "start": 10.68,
    "text": "वैसे ही अब दूसरा नियम भी याद कर लो"
  },
  {
    "start": 13.12,
    "text": "और परीक्षा में कैसे लिखना है वो समझो"
  },
  {
    "start": 15.5,
    "text": "तो दूसरा नियम कहता है कि"
  },
  {
    "start": 17.78,
    "text": "जब अलग-अलग विद्युत्-अपघट्यों में"
  },
  {
    "start": 20.08,
    "text": "समान मात्रा में विद्युत् प्रवाहित की जाती है"
  },
  {
    "start": 22.62,
    "text": "तो इलेक्ट्रोड पर मुक्त होने वाले"
  },
  {
    "start": 25.0,
    "text": "पदार्थों की मात्राएँ उनके रासायनिक"
  },
  {
    "start": 26.54,
    "text": "तुल्यांक के"
  },
  {
    "start": 28.08,
    "text": "समानुपाती होती है"
  },
  {
    "start": 29.34,
    "text": "मतलब, रासायनिक तुल्यांक जितना"
  },
  {
    "start": 31.12,
    "text": "अधिक होगा"
  },
  {
    "start": 32.9,
    "text": "मुक्त होने वाले पदार्थ की"
  },
  {
    "start": 34.3,
    "text": "मात्राएँ में तुछी है"
  },
  {
    "start": 36.16,
    "text": "W के समानुपाती है"
  },
  {
    "start": 39.02,
    "text": "अगर उनकी मुक्त मात्रा,"
  },
  {
    "start": 41.18,
    "text": "मात्राएँ W1 और W2 है"
  },
  {
    "start": 52.26,
    "text": "इसलिए दोनों मुक्त मात्राओं का अनुपात"
  },
  {
    "start": 55.2,
    "text": "उनके रासायनिक तुल्यांकों के अनुपात के"
  },
  {
    "start": 56.96,
    "text": "बराबर होगा"
  },
  {
    "start": 58.72,
    "text": "W1 बटा W2 बराबर E1 बटा E2"
  },
  {
    "start": 62.14,
    "text": "बस इतना याद रखना"
  },
  {
    "start": 63.88,
    "text": "पहले नियम में विद्युत् की मात्रा बदलेगी"
  },
  {
    "start": 66.48,
    "text": "तो पदार्थ की मात्रा बदलेगी"
  },
  {
    "start": 67.96,
    "text": "W बराबर Z गुना i गुना t"
  },
  {
    "start": 71.36,
    "text": "और दूसरे नियम में विद्युत् की मात्रा समान"
  },
  {
    "start": 73.42,
    "text": "होगी"
  },
  {
    "start": 75.48,
    "text": "तो पदार्थ की मात्रा रासायनिक तुल्यांक पर"
  },
  {
    "start": 77.4,
    "text": "निर्भर करेगी"
  },
  {
    "start": 79.32,
    "text": "W1 बटा W2 बराबर E1 बटा E2"
  },
  {
    "start": 83.5,
    "text": "बच्चों, बस ये दो बातें याद रखनी"
  },
  {
    "start": 86.56,
    "text": "तो परीक्षा में फैराडे के दोनों नियमों का"
  },
  {
    "start": 89.22,
    "text": "पूरा उत्तर कभी नहीं भूलोगे"
  },
  {
    "start": 91.22,
    "text": "अब इसे परीक्षा में सही तरीके से"
  },
  {
    "start": 93.84,
    "text": "कैसे लिखना है, इसका पूरा उत्तर"
  },
  {
    "start": 96.26,
    "text": "आपकी स्क्रीन पर आ जाएगा"
  },
  {
    "start": 97.92,
    "text": "इसे सेव कर लेना"
  },
  {
    "start": 99.5,
    "text": "और स्क्रीनशॉट लेना मत भूलना"
  },
  {
    "start": 101.26,
    "text": "और ऐसे ही आसान और मजेदार तरीके से"
  },
  {
    "start": 104.26,
    "text": "पढ़ने के लिए अरिविहान के उन्नति बैच से"
  },
  {
    "start": 105.76,
    "text": "जुड़ो"
  }
]