[
  {
    "start": 0.0,
    "text": "एमपी बोर्ड कक्षा 12वीं के बच्चों"
  },
  {
    "start": 2.24,
    "text": "ये सवाल 2023 और 2025 में आ चुका है"
  },
  {
    "start": 6.12,
    "text": "और इस बार भी आपकी त्रैमासिक परीक्षा में"
  },
  {
    "start": 7.8,
    "text": "आ सकता है"
  },
  {
    "start": 9.48,
    "text": "तो चलो इसे ऐसे याद करते हैं"
  },
  {
    "start": 11.46,
    "text": "कि परीक्षा में आपके 4 नंबर पक्के हो जाएं"
  },
  {
    "start": 14.08,
    "text": "सबसे पहले समझते हैं फैराडे का पहला"
  },
  {
    "start": 15.46,
    "text": "नियम"
  },
  {
    "start": 16.84,
    "text": "और इसे ध्यान से समझना"
  },
  {
    "start": 18.5,
    "text": "क्योंकि अगर परीक्षा में बिल्कुल ऐसा ही"
  },
  {
    "start": 20.18,
    "text": "लिख दिया"
  },
  {
    "start": 21.86,
    "text": "तो आपके 4 नंबर पक्के हैं"
  },
  {
    "start": 24.4,
    "text": "तो जब विद्युत्-अपघटन के दौरान"
  },
  {
    "start": 26.44,
    "text": "किसी इलेक्ट्रोड पर मुक्त होने वाले पदार्थ"
  },
  {
    "start": 27.81,
    "text": "की मात्रा"
  },
  {
    "start": 29.18,
    "text": "प्रवाहित विद्युत् की मात्रा के समानुपाती"
  },
  {
    "start": 31.23,
    "text": "होती है"
  },
  {
    "start": 33.28,
    "text": "मतलब पदार्थ की मुक्त मात्रा"
  },
  {
    "start": 35.34,
    "text": "विद्युत् की मात्रा के समानुपाती होती है"
  },
  {
    "start": 37.8,
    "text": "W समानुपाती Q"
  },
  {
    "start": 39.96,
    "text": "यहाँ W है मुक्त पदार्थ की मात्रा"
  },
  {
    "start": 42.46,
    "text": "और Q है प्रवाहित विद्युत् की मात्रा"
  },
  {
    "start": 44.74,
    "text": "अब विद्युत् की मात्रा को हम ऐसे लिख सकते"
  },
  {
    "start": 46.32,
    "text": "हैं"
  },
  {
    "start": 47.9,
    "text": "Q बराबर i गुना t"
  },
  {
    "start": 50.96,
    "text": "जहाँ i है विद्युत् धारा"
  },
  {
    "start": 53.12,
    "text": "और t है समय"
  },
  {
    "start": 54.44,
    "text": "इसलिए Q की जगह इसका मान रख देते हैं"
  },
  {
    "start": 56.86,
    "text": "W समानुपाती i गुना t"
  },
  {
    "start": 59.7,
    "text": "समानुपात हटाने पर"
  },
  {
    "start": 61.1,
    "text": "W बराबर Z गुना i गुना t"
  },
  {
    "start": 64.86,
    "text": "जहाँ Z है विद्युत्-रासायनिक तुल्यांक"
  },
  {
    "start": 67.9,
    "text": "तो पहले नियम में बस इतना याद रखो"
  },
  {
    "start": 70.66,
    "text": "जितनी अधिक विद्युत् प्रवाहित होगी"
  },
  {
    "start": 73.02,
    "text": "उतनी ही अधिक पदार्थ की मात्रा मुक्त होगी"
  },
  {
    "start": 75.9,
    "text": "W बराबर Z गुना i गुना t"
  },
  {
    "start": 78.4,
    "text": "तो बच्चों आपने फैराडे का पहला नियम तो"
  },
  {
    "start": 80.34,
    "text": "समझ लिया"
  },
  {
    "start": 82.28,
    "text": "लेकिन आप दूसरा नियम क्या कहता है"
  },
  {
    "start": 84.38,
    "text": "और दोनों नियमों का पूरा उत्तर"
  },
  {
    "start": 86.72,
    "text": "परीक्षा में कैसे लिखना है"
  },
  {
    "start": 88.78,
    "text": "ये समझेंगे अगले पार्ट में"
  }
]