[
 {
  "start": 0.0,
  "end": 1.52,
  "text": "MP Board कक्षा"
 },
 {
  "start": 1.52,
  "end": 2.32,
  "text": "बारहवीं के बच्चों,"
 },
 {
  "start": 2.32,
  "end": 4.3,
  "text": "ये सवाल 2018 में"
 },
 {
  "start": 4.3,
  "end": 5.66,
  "text": "पूछा जा चुका है,"
 },
 {
  "start": 5.66,
  "end": 7.3,
  "text": "और इस बार भी आपकी board"
 },
 {
  "start": 7.3,
  "end": 8.78,
  "text": "exam में आ सकता है।"
 },
 {
  "start": 8.78,
  "end": 10.78,
  "text": "पूरे 3 नंबर का सवाल है,"
 },
 {
  "start": 10.78,
  "end": 12.011,
  "text": "तो चलो इसे एकदम आसान"
 },
 {
  "start": 12.011,
  "end": 13.18,
  "text": "तरीके से समझते हैं।"
 },
 {
  "start": 13.18,
  "end": 14.52,
  "text": "सबसे पहले दोनों तत्वों"
 },
 {
  "start": 14.52,
  "end": 15.82,
  "text": "की परमाणु संख्याएँ देखो।"
 },
 {
  "start": 15.82,
  "end": 18.16,
  "text": "Mn की परमाणु संख्या 25 है,"
 },
 {
  "start": 18.16,
  "end": 21.62,
  "text": "और Fe की परमाणु संख्या 26 है।"
 },
 {
  "start": 21.62,
  "end": 22.48,
  "text": "अब ध्यान दो, Fe"
 },
 {
  "start": 22.48,
  "end": 23.64,
  "text": "की परमाणु संख्या,"
 },
 {
  "start": 23.64,
  "end": 25.44,
  "text": "Mn से एक ज्यादा है।"
 },
 {
  "start": 25.44,
  "end": 27.66,
  "text": "इसका मतलब, Fe के नाभिक"
 },
 {
  "start": 27.66,
  "end": 29.34,
  "text": "में एक प्रोटॉन ज्यादा है।"
 },
 {
  "start": 29.34,
  "end": 31.96,
  "text": "Mn में 25 प्रोटॉन होते हैं,"
 },
 {
  "start": 31.96,
  "end": 33.28,
  "text": "जबकि Fe में 26"
 },
 {
  "start": 33.28,
  "end": 34.62,
  "text": "प्रोटॉन होते हैं।"
 },
 {
  "start": 34.62,
  "end": 37.24,
  "text": "अब जब हम Mn2+ और Fe2+"
 },
 {
  "start": 37.24,
  "end": 38.62,
  "text": "ions की बात करते हैं,"
 },
 {
  "start": 38.62,
  "end": 39.5,
  "text": "तो दोनों ने दो"
 },
 {
  "start": 39.5,
  "end": 41.42,
  "text": "इलेक्ट्रॉन दे दिए हैं।"
 },
 {
  "start": 41.42,
  "end": 42.54,
  "text": "इसलिए दोनों में इलेक्ट्रॉन"
 },
 {
  "start": 42.54,
  "end": 45.84,
  "text": "की संख्या तुलनीय है,"
 },
 {
  "start": 45.84,
  "end": 46.8,
  "text": "लेकिन Fe2+ में नाभिकीय"
 },
 {
  "start": 46.8,
  "end": 48.28,
  "text": "आवेश ज्यादा है,"
 },
 {
  "start": 48.28,
  "end": 49.42,
  "text": "क्योंकि उसमें एक"
 },
 {
  "start": 49.42,
  "end": 50.8,
  "text": "प्रोटॉन ज्यादा है।"
 },
 {
  "start": 50.8,
  "end": 52.76,
  "text": "अब यहाँ एक important point है,"
 },
 {
  "start": 52.76,
  "end": 54.38,
  "text": "जब नाभिक में प्रोटॉनों"
 },
 {
  "start": 54.38,
  "end": 55.702,
  "text": "की संख्या बढ़ती है,"
 },
 {
  "start": 55.702,
  "end": 56.502,
  "text": "तो नाभिक और"
 },
 {
  "start": 56.502,
  "end": 57.68,
  "text": "इलेक्ट्रॉनों के बीच"
 },
 {
  "start": 57.68,
  "end": 58.48,
  "text": "स्थिरवैद्युत"
 },
 {
  "start": 58.48,
  "end": 60.352,
  "text": "आकर्षण बढ़ जाता है।"
 },
 {
  "start": 60.352,
  "end": 62.52,
  "text": "नाभिकीय आवेश बढ़ने पर,"
 },
 {
  "start": 62.52,
  "end": 63.64,
  "text": "नाभिक और इलेक्ट्रॉनों के"
 },
 {
  "start": 63.64,
  "end": 65.06,
  "text": "बीच आकर्षण बल बढ़ता है,"
 },
 {
  "start": 65.06,
  "end": 67.08,
  "text": "और आयनिक त्रिज्या कम होती है।"
 },
 {
  "start": 67.08,
  "end": 68.98,
  "text": "इस अधिक आकर्षण के कारण,"
 },
 {
  "start": 68.98,
  "end": 70.46,
  "text": "इलेक्ट्रॉन मेघ नाभिक की"
 },
 {
  "start": 70.46,
  "end": 72.2,
  "text": "ओर अधिक खिंच जाता है।"
 },
 {
  "start": 72.2,
  "end": 74.36,
  "text": "इसलिए Fe2+ की त्रिज्या,"
 },
 {
  "start": 74.36,
  "end": 76.08,
  "text": "Mn2+ की तुलना में"
 },
 {
  "start": 76.08,
  "end": 76.92,
  "text": "छोटा हो जाता है।"
 },
 {
  "start": 76.92,
  "end": 78.58,
  "text": "तो यही कारण है कि,"
 },
 {
  "start": 78.58,
  "end": 80.52,
  "text": "Fe2+ की त्रिज्या,"
 },
 {
  "start": 80.52,
  "end": 82.14,
  "text": "Mn2+ की त्रिज्या"
 },
 {
  "start": 82.14,
  "end": 83.28,
  "text": "से कम होती है।"
 },
 {
  "start": 83.28,
  "end": 84.26,
  "text": "तो बच्चों, ये topic"
 },
 {
  "start": 84.26,
  "end": 85.4,
  "text": "तो दिमाग में बैठ गया।"
 },
 {
  "start": 85.4,
  "end": 86.9,
  "text": "बस, इस question में आपको"
 },
 {
  "start": 86.9,
  "end": 88.486,
  "text": "यही logic याद रखना है,"
 },
 {
  "start": 88.486,
  "end": 89.64,
  "text": "जैसे-जैसे atomic"
 },
 {
  "start": 89.64,
  "end": 91.09,
  "text": "number बढ़ता गया,"
 },
 {
  "start": 91.09,
  "end": 92.46,
  "text": "वैसे-वैसे nuclear"
 },
 {
  "start": 92.46,
  "end": 93.26,
  "text": "charge बढ़ता गया,"
 },
 {
  "start": 93.26,
  "end": 95.84,
  "text": "और attraction बढ़ने से"
 },
 {
  "start": 95.84,
  "end": 96.98,
  "text": "ionic radius कम होती गई।"
 },
 {
  "start": 96.98,
  "end": 99.24,
  "text": "अब इसका exact answer,"
 },
 {
  "start": 99.24,
  "end": 100.7,
  "text": "exam में किस तरह लिखना है,"
 },
 {
  "start": 100.7,
  "end": 102.42,
  "text": "वो आपको Notes button पर"
 },
 {
  "start": 102.42,
  "end": 104.1,
  "text": "click करके मिल जाएगा।"
 },
 {
  "start": 104.1,
  "end": 106.18,
  "text": "ऐसे ही छोटे-छोटे chemistry"
 },
 {
  "start": 106.18,
  "end": 108.26,
  "text": "के concept तैयार करते जाओ,"
 },
 {
  "start": 108.26,
  "end": 109.15,
  "text": "ताकि exam में इस question"
 },
 {
  "start": 109.15,
