[
 {
  "start": 0.0,
  "end": 0.8,
  "text": "MP Board कक्षा"
 },
 {
  "start": 0.8,
  "end": 2.2,
  "text": "बारहवीं के बच्चों,"
 },
 {
  "start": 2.2,
  "end": 4.61,
  "text": "ये सवाल 2022 और 2023 में,"
 },
 {
  "start": 4.61,
  "end": 5.96,
  "text": "board exam में"
 },
 {
  "start": 5.96,
  "end": 7.14,
  "text": "पूछा जा चुका है,"
 },
 {
  "start": 7.14,
  "end": 8.44,
  "text": "और इस साल भी आपकी"
 },
 {
  "start": 8.44,
  "end": 10.06,
  "text": "परीक्षा में आ सकता है।"
 },
 {
  "start": 10.06,
  "end": 11.94,
  "text": "सवाल है, दात्र कोशिका"
 },
 {
  "start": 11.94,
  "end": 13.92,
  "text": "अरक्तता को परिभाषित कर लिखिए।"
 },
 {
  "start": 13.92,
  "end": 16.02,
  "text": "तो बच्चों, आज इसको सिर्फ"
 },
 {
  "start": 16.02,
  "end": 16.82,
  "text": "definition की तरह नहीं,"
 },
 {
  "start": 16.82,
  "end": 18.58,
  "text": "बल्कि इसके पूरे कारण और"
 },
 {
  "start": 18.58,
  "end": 19.66,
  "text": "effect के साथ समझेंगे,"
 },
 {
  "start": 19.66,
  "end": 22.48,
  "text": "ताकि answer आसानी से याद रहे।"
 },
 {
  "start": 22.48,
  "end": 23.6,
  "text": "सबसे पहले समझो बच्चों,"
 },
 {
  "start": 23.6,
  "end": 25.795,
  "text": "दात्र कोशिका अरक्तता, यानी,"
 },
 {
  "start": 25.795,
  "end": 27.24,
  "text": "Sickle Cell Anaemia"
 },
 {
  "start": 27.24,
  "end": 28.04,
  "text": "क्या होती है?"
 },
 {
  "start": 28.04,
  "end": 30.76,
  "text": "दात्र कोशिका अरक्तता, एक"
 },
 {
  "start": 30.76,
  "end": 31.64,
  "text": "आनुवंशिक रक्त विकार है,"
 },
 {
  "start": 31.64,
  "end": 33.02,
  "text": "जो जीन में होने वाले"
 },
 {
  "start": 33.02,
  "end": 35.2,
  "text": "उत्परिवर्तन, यानी,"
 },
 {
  "start": 35.2,
  "end": 36.46,
  "text": "Mutation के कारण होता है।"
 },
 {
  "start": 36.46,
  "end": 38.74,
  "text": "अब इस mutation के कारण,"
 },
 {
  "start": 38.74,
  "end": 39.54,
  "text": "हीमोग्लोबिन का एक"
 },
 {
  "start": 39.54,
  "end": 41.0,
  "text": "असामान्य प्रकार बनता है,"
 },
 {
  "start": 41.0,
  "end": 42.9,
  "text": "जिसे HbS, यानी, Sickle"
 },
 {
  "start": 42.9,
  "end": 44.36,
  "text": "Haemoglobin कहते हैं।"
 },
 {
  "start": 44.36,
  "end": 45.84,
  "text": "और बच्चों, यहीं"
 },
 {
  "start": 45.84,
  "end": 47.376,
  "text": "से इस बीमारी की,"
 },
 {
  "start": 47.376,
  "end": 48.72,
  "text": "सबसे important"
 },
 {
  "start": 48.72,
  "end": 50.64,
  "text": "पहचान सामने आती है।"
 },
 {
  "start": 50.64,
  "end": 52.98,
  "text": "HbS की उपस्थिति में, लाल"
 },
 {
  "start": 52.98,
  "end": 55.46,
  "text": "रक्त कोशिकाएँ, यानी, RBCs,"
 },
 {
  "start": 55.46,
  "end": 57.72,
  "text": "अपना सामान्य आकार"
 },
 {
  "start": 57.72,
  "end": 58.9,
  "text": "बनाए रखने के बजाय,"
 },
 {
  "start": 58.9,
  "end": 60.96,
  "text": "दात्र, यानी, Sickle के"
 },
 {
  "start": 60.96,
  "end": 63.57,
  "text": "आकार की हो सकती हैं।"
 },
 {
  "start": 63.57,
  "end": 65.03,
  "text": "अब ध्यान से सुनो,"
 },
 {
  "start": 65.03,
  "end": 66.41,
  "text": "सामान्य लाल रक्त कोशिकाएँ,"
 },
 {
  "start": 66.41,
  "end": 68.11,
  "text": "आसानी से रक्त वाहिकाओं"
 },
 {
  "start": 68.11,
  "end": 69.53,
  "text": "में प्रवाहित होती हैं,"
 },
 {
  "start": 69.53,
  "end": 71.301,
  "text": "लेकिन दात्राकार"
 },
 {
  "start": 71.301,
  "end": 73.19,
  "text": "RBCs, कठोर होकर,"
 },
 {
  "start": 73.19,
  "end": 74.17,
  "text": "छोटी रक्त वाहिकाओं में"
 },
 {
  "start": 74.17,
  "end": 76.15,
  "text": "रुकावट पैदा कर सकती हैं।"
 },
 {
  "start": 76.15,
  "end": 77.21,
  "text": "इस रक्त प्रवाह में"
 },
 {
  "start": 77.21,
  "end": 78.91,
  "text": "रुकावट के कारण,"
 },
 {
  "start": 78.91,
  "end": 79.99,
  "text": "शरीर के विभिन्न"
 },
 {
  "start": 79.99,
  "end": 81.603,
  "text": "अंगों और ऊतकों तक,"
 },
 {
  "start": 81.603,
  "end": 83.036,
  "text": "पर्याप्त ऑक्सीजन"
 },
 {
  "start": 83.036,
  "end": 84.47,
  "text": "नहीं पहुँच पाती।"
 },
 {
  "start": 84.47,
  "end": 86.87,
  "text": "यानी, शरीर में oxygen"
 },
 {
  "start": 86.87,
  "end": 88.47,
  "text": "supply प्रभावित हो जाती है।"
 },
 {
  "start": 88.47,
  "end": 91.35,
  "text": "तो बच्चों, इस पूरे concept को,"
 },
 {
  "start": 91.35,
  "end": 92.79,
  "text": "एक sequence में"
 },
 {
  "start": 92.79,
  "end": 94.59,
  "text": "दिमाग में बिठा लो।"
 },
 {
  "start": 94.59,
  "end": 95.99,
  "text": "यानी, exam में"
 },
 {
  "start": 95.99,
  "end": 98.09,
  "text": "definition लिखते समय,"
 },
 {
  "start": 98.09,
  "end": 99.11,
  "text": "आपको यह जरूर बताना है कि,"
 },
 {
  "start": 99.11,
  "end": 101.16,
  "text": "यह जीन में उत्परिवर्तन के कारण"
 },
 {
  "start": 101.16,
  "end": 102.39,
  "text": "होने वाला,आनुवंशिक"
 },
 {
  "start": 102.39,
  "end": 103.49,
  "text": "रक्त विकार है,"
 },
 {
  "start": 103.49,
  "end": 104.666,
  "text": "जिसमें HbS बनता है, और"
 },
 {
  "start": 104.666,
  "end": 106.11,
  "text": "RBCs दात्राकार हो जाती हैं,"
 },
 {
  "start": 106.11,
  "end": 109.95,
  "text": "जिससे रक्त प्रवाह, और शरीर में"
 },
 {
  "start": 109.95,
  "end": 111.17,
  "text": "ऑक्सीजन की आपूर्ति"
 },
 {
  "start": 111.17,
  "end": 112.51,
  "text": "प्रभावित होती है।"
 },
 {
  "start": 112.51,
  "end": 114.87,
  "text": "एक line में गाँठ बाँध लो,"
 },
 {
  "start": 114.87,
  "end": 117.396,
  "text": "Mutation से HbS, HbS"
 },
 {
  "start": 117.396,
  "end": 119.67,
  "text": "से दात्राकार RBCs,"
 },
 {
  "start": 119.67,
  "end": 121.257,
  "text": "और दात्राकार RBCs से, blood"
 },
 {
  "start": 121.257,
  "end": 122.139,
  "text": "flow तथा oxygen"
 },
 {
  "start": 122.139,
  "end": 123.08,
  "text": "supply प्रभावित।"
 },
 {
  "start": 123.08,
  "end": 124.275,
  "text": "तो बच्चों, दात्र"
 },
 {
  "start": 124.275,
  "end": 125.32,
  "text": "कोशिका अरक्तता"
 },
 {
  "start": 125.32,
  "end": 127.22,
  "text": "वाला सवाल भी पूरा हो गया।"
 },
 {
  "start": 127.22,
  "end": 129.02,
  "text": "अब परीक्षा में इसका exact"
 },
 {
  "start": 129.02,
  "end": 129.82,
  "text": "answer कैसे लिखना है,"
 },
 {
  "start": 129.82,
  "end": 130.98,
  "text": "वो आपकी screen के"
 },
 {
  "start": 130.98,
  "end": 132.18,
  "text": "right side में दिए,"
 },
 {
  "start": 132.18,
  "end": 133.48,
  "text": "Notes button पर मिल जाएगा।"
 },
 {
  "start": 133.48,
  "end": 135.35,
  "text": "अब ऐसे ही आगे की पढ़ाई"
 },
 {
  "start": 135.35,
  "end": 137.41,
  "text": "वाली reels देखते रहो,"
 },
 {
  "start": 137.41,
  "end": 138.21,
  "text": "एक-एक करके सिलेबस"
 },
 {
  "start": 138.21,
  "end": 139.09,
  "text": "पूरा करते जाओ,"
 },
 {
  "start": 139.09,
  "end": 140.29,
  "text": "और 90 परसेंट की"
 },
 {
  "start": 140.29,
  "end": 141.43,
  "text": "तैयारी मजबूत करो।"
 }
]