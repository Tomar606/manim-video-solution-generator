[
 {
  "start": 0.0,
  "end": 1.54,
  "text": "MP Board कक्षा"
 },
 {
  "start": 1.54,
  "end": 2.34,
  "text": "बारहवीं के बच्चों,"
 },
 {
  "start": 2.34,
  "end": 4.28,
  "text": "ये सवाल 2024 में board"
 },
 {
  "start": 4.28,
  "end": 6.02,
  "text": "exam में पूछा जा चुका है,"
 },
 {
  "start": 6.02,
  "end": 7.6,
  "text": "और इस साल भी आपकी परीक्षा"
 },
 {
  "start": 7.6,
  "end": 9.3,
  "text": "में आने के पूरे chances है।"
 },
 {
  "start": 9.3,
  "end": 11.86,
  "text": "ये सवाल पूरे 3 नंबर का आता है,"
 },
 {
  "start": 11.86,
  "end": 14.22,
  "text": "इसलिए इसे ध्यान से समझना।"
 },
 {
  "start": 14.22,
  "end": 15.76,
  "text": "तो चलिए शुरू करते हैं,"
 },
 {
  "start": 15.76,
  "end": 17.438,
  "text": "ऊर्जा का पिरामिड,"
 },
 {
  "start": 17.438,
  "end": 18.82,
  "text": "किसी पारितंत्र"
 },
 {
  "start": 18.82,
  "end": 19.9,
  "text": "के अलग-अलग पोषण स्तरों पर,"
 },
 {
  "start": 19.9,
  "end": 21.32,
  "text": "उपस्थित ऊर्जा का"
 },
 {
  "start": 21.32,
  "end": 23.16,
  "text": "चित्रात्मक निरूपण है।"
 },
 {
  "start": 23.16,
  "end": 26.2,
  "text": "यानी, यह बताता है कि एक पोषण"
 },
 {
  "start": 26.2,
  "end": 28.44,
  "text": "स्तर से अगले पोषण स्तर तक,"
 },
 {
  "start": 28.44,
  "end": 30.24,
  "text": "ऊर्जा का प्रवाह"
 },
 {
  "start": 30.24,
  "end": 31.14,
  "text": "किस प्रकार होता है।"
 },
 {
  "start": 31.14,
  "end": 32.74,
  "text": "इस पिरामिड का सबसे नीचे"
 },
 {
  "start": 32.74,
  "end": 34.4,
  "text": "वाला और सबसे चौड़ा भाग,"
 },
 {
  "start": 34.4,
  "end": 36.68,
  "text": "उत्पादकों को दर्शाता है।"
 },
 {
  "start": 36.68,
  "end": 38.38,
  "text": "उत्पादकों के पास, ऊर्जा की"
 },
 {
  "start": 38.38,
  "end": 40.258,
  "text": "मात्रा सबसे अधिक होती है।"
 },
 {
  "start": 40.258,
  "end": 41.76,
  "text": "जैसे-जैसे हम पिरामिड"
 },
 {
  "start": 41.76,
  "end": 43.04,
  "text": "में ऊपर की ओर बढ़ते हैं,"
 },
 {
  "start": 43.04,
  "end": 44.7,
  "text": "पोषण स्तर बदलते जाते हैं,"
 },
 {
  "start": 44.7,
  "end": 45.96,
  "text": "और उपलब्ध ऊर्जा"
 },
 {
  "start": 45.96,
  "end": 47.199,
  "text": "कम होती जाती है।"
 },
 {
  "start": 47.199,
  "end": 48.516,
  "text": "लेकिन सवाल ये है,"
 },
 {
  "start": 48.516,
  "end": 50.22,
  "text": "कि ऊपर जाते-जाते ऊर्जा"
 },
 {
  "start": 50.22,
  "end": 51.36,
  "text": "कम क्यों होती है?"
 },
 {
  "start": 51.36,
  "end": 53.66,
  "text": "इसका कारण है, ऊर्जा का ह्रास।"
 },
 {
  "start": 53.66,
  "end": 54.46,
  "text": "ध्यान से सुनो,"
 },
 {
  "start": 54.46,
  "end": 56.88,
  "text": "प्रकृति में ऊर्जा, एक पोषण"
 },
 {
  "start": 56.88,
  "end": 58.76,
  "text": "स्तर से दूसरे पोषण स्तर तक,"
 },
 {
  "start": 58.76,
  "end": 59.7,
  "text": "पूरी की पूरी"
 },
 {
  "start": 59.7,
  "end": 61.7,
  "text": "स्थानांतरित नहीं होती।"
 },
 {
  "start": 61.7,
  "end": 64.489,
  "text": "जीव अपनी ऊर्जा का एक बड़ा भाग,"
 },
 {
  "start": 64.489,
  "end": 66.5,
  "text": "श्वसन जैसी जीवन-क्रियाओं"
 },
 {
  "start": 66.5,
  "end": 67.3,
  "text": "में खर्च करते हैं,"
 },
 {
  "start": 67.3,
  "end": 69.08,
  "text": "और इसका काफी हिस्सा,"
 },
 {
  "start": 69.08,
  "end": 69.88,
  "text": "ऊष्मा के रूप में"
 },
 {
  "start": 69.88,
  "end": 72.22,
  "text": "पर्यावरण में चला जाता है।"
 },
 {
  "start": 72.22,
  "end": 75.48,
  "text": "इसलिए उत्पादक से, शाकाहारी,"
 },
 {
  "start": 75.48,
  "end": 78.44,
  "text": "और शाकाहारी से मांसाहारी तक,"
 },
 {
  "start": 78.44,
  "end": 80.58,
  "text": "ऊर्जा कम होती जाती है।"
 },
 {
  "start": 80.58,
  "end": 82.4,
  "text": "यानी, हर अगले पोषी"
 },
 {
  "start": 82.4,
  "end": 83.92,
  "text": "स्तर पर उपलब्ध ऊर्जा,"
 },
 {
  "start": 83.92,
  "end": 85.86,
  "text": "पिछले स्तर से कम होती है।"
 },
 {
  "start": 85.86,
  "end": 87.56,
  "text": "और अब इसी बात को एक"
 },
 {
  "start": 87.56,
  "end": 89.96,
  "text": "आसान rule से समझते हैं,"
 },
 {
  "start": 89.96,
  "end": 91.5,
  "text": "10 प्रतिशत का नियम।"
 },
 {
  "start": 91.5,
  "end": 92.4,
  "text": "पारिस्थितिकी में"
 },
 {
  "start": 92.4,
  "end": 94.26,
  "text": "सामान्यतः माना जाता है,"
 },
 {
  "start": 94.26,
  "end": 96.48,
  "text": "कि एक पोषण स्तर की लगभग"
 },
 {
  "start": 96.48,
  "end": 98.0,
  "text": "10 प्रतिशत ऊर्जा ही,"
 },
 {
  "start": 98.0,
  "end": 100.42,
  "text": "अगले पोषण स्तर तक पहुँचती है।"
 },
 {
  "start": 100.42,
  "end": 102.24,
  "text": "बाकी ऊर्जा, विभिन्न"
 },
 {
  "start": 102.24,
  "end": 103.63,
  "text": "जैविक क्रियाओं में"
 },
 {
  "start": 103.63,
  "end": 105.02,
  "text": "उपयोग होकर,मुख्यतः"
 },
 {
  "start": 105.02,
  "end": 106.54,
  "text": "ऊष्मा के रूप में"
 },
 {
  "start": 106.54,
  "end": 107.64,
  "text": "नष्ट हो जाती है।"
 },
 {
  "start": 107.64,
  "end": 109.88,
  "text": "बच्चों, अब इसे उदाहरण से समझो।"
 },
 {
  "start": 109.88,
  "end": 111.84,
  "text": "अगर उत्पादक के पास"
 },
 {
  "start": 111.84,
  "end": 113.12,
  "text": "1000 इकाई ऊर्जा है,"
 },
 {
  "start": 113.12,
  "end": 114.22,
  "text": "तो अगले पोषण स्तर"
 },
 {
  "start": 114.22,
  "end": 116.08,
  "text": "को लगभग सौ इकाई,"
 },
 {
  "start": 116.08,
  "end": 117.76,
  "text": "फिर अगले को लगभग 10 इकाई,"
 },
 {
  "start": 117.76,
  "end": 119.42,
  "text": "और उसके बाद लगभग 1 इकाई"
 },
 {
  "start": 119.42,
  "end": 121.22,
  "text": "ऊर्जा ही प्रवाहित हो सकती है।"
 },
 {
  "start": 121.22,
  "end": 123.393,
  "text": "तो बच्चों, यही वजह है कि ऊर्जा"
 },
 {
  "start": 123.393,
  "end": 124.48,
  "text": "पिरामिड का base"
 },
 {
  "start": 124.48,
  "end": 125.34,
  "text": "सबसे चौड़ा होता है,"
 },
 {
  "start": 125.34,
  "end": 127.18,
  "text": "और ऊपर जाते-जाते पिरामिड"
 },
 {
  "start": 127.18,
  "end": 129.32,
  "text": "सकरा होता जाता है।"
 },
 {
  "start": 129.32,
  "end": 131.08,
  "text": "तो इस concept को याद कर लो,"
 },
 {
  "start": 131.08,
  "end": 133.26,
  "text": "की उत्पादकों में ऊर्जा"
 },
 {
  "start": 133.26,
  "end": 134.06,
  "text": "सबसे अधिक होती है,"
 },
 {
  "start": 134.06,
  "end": 135.92,
  "text": "फिर प्रत्येक अगले पोषण स्तर"
 },
 {
  "start": 135.92,
  "end": 137.84,
  "text": "पर ऊर्जा कम होती जाती है।"
 },
 {
  "start": 137.84,
  "end": 139.58,
  "text": "इसी कारण ऊर्जा का पिरामिड"
 },
 {
  "start": 139.58,
  "end": 141.0,
  "text": "हमेशा सीधा होता है।"
 },
 {
  "start": 141.0,
  "end": 142.38,
  "text": "तो बच्चों, ये टॉपिक"
 },
 {
  "start": 142.38,
  "end": 143.56,
  "text": "भी clear हो गया।"
 },
 {
  "start": 143.56,
  "end": 145.56,
  "text": "अब परीक्षा में इसका exact"
 },
 {
  "start": 145.56,
  "end": 146.66,
  "text": "answer कैसे लिखना है,"
 },
 {
  "start": 146.66,
  "end": 147.94,
  "text": "वो आपकी screen"
 },
 {
  "start": 147.94,
  "end": 149.06,
  "text": "के right side में"
 },
 {
  "start": 149.06,
  "end": 150.08,
  "text": "दिए Notes button पर मिल जाएगा।"
 },
 {
  "start": 150.08,
  "end": 152.1,
  "text": "अब ऐसे ही आगे की पढ़ाई"
 },
 {
  "start": 152.1,
  "end": 153.32,
  "text": "वाली reels देखते रहो,"
 },
 {
  "start": 153.32,
  "end": 155.22,
  "text": "और सिलेबस पूरा करते रहो।"
 }
]