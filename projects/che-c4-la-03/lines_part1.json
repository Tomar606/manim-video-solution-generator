[
  {
    "start": 0.0,
    "end": 3.12,
    "text": "मेरे MP बोर्ड कक्षा बारहवीं के बच्चों,"
  },
  {
    "start": 3.22,
    "end": 6.24,
    "text": "ये सवाल 2019 और 2022 में"
  },
  {
    "start": 6.24,
    "end": 8.46,
    "text": "परीक्षा में पूछा जा चुका है"
  },
  {
    "start": 8.46,
    "end": 11.44,
    "text": "और इस साल भी बोर्ड एग्जाम में आ सकता है।"
  },
  {
    "start": 11.44,
    "end": 13.34,
    "text": "अगर इसे अच्छे से कर लिया"
  },
  {
    "start": 13.34,
    "end": 15.18,
    "text": "तो चार नम्बर पक्के हैं।"
  },
  {
    "start": 15.18,
    "end": 16.64,
    "text": "आज इस पूरे सवाल को"
  },
  {
    "start": 16.64,
    "end": 18.96,
    "text": "चार अलग-अलग कारणों से समझेंगे,"
  },
  {
    "start": 19.06,
    "end": 21.42,
    "text": "जो परीक्षा में बिल्कुल नहीं भूलना हैं।"
  },
  {
    "start": 21.42,
    "end": 22.68,
    "text": "सबसे पहले याद रखो,"
  },
  {
    "start": 22.96,
    "end": 25.5,
    "text": "सामान्य इलेक्ट्रॉनिक विन्यास।"
  },
  {
    "start": 25.5,
    "end": 27.98,
    "text": "इसे ध्यान से सुनना और याद रखना,"
  },
  {
    "start": 27.98,
    "end": 30.14,
    "text": "क्योंकि परीक्षा में इसे ऐसे ही लिखोगे"
  },
  {
    "start": 30.14,
    "end": 31.48,
    "text": "तो नम्बर मिलेंगे।"
  },
  {
    "start": 31.8,
    "end": 34.12,
    "text": "संक्रमण तत्वों में d कक्षक में"
  },
  {
    "start": 34.12,
    "end": 35.88,
    "text": "1-10 और s कक्षक में"
  },
  {
    "start": 35.88,
    "end": 38.04,
    "text": "1-2 इलेक्ट्रॉन होते हैं।"
  },
  {
    "start": 38.08,
    "end": 40.84,
    "text": "यही इनका सामान्य इलेक्ट्रॉनिक विन्यास है।"
  },
  {
    "start": 40.84,
    "end": 42.86,
    "text": "अब इसी विन्यास से संक्रमण तत्वों के"
  },
  {
    "start": 42.86,
    "end": 44.46,
    "text": "ये चारों गुण समझ में आएंगे।"
  },
  {
    "start": 44.58,
    "end": 46.34,
    "text": "चलो पहला गुण समझते हैं —"
  },
  {
    "start": 46.34,
    "end": 48.48,
    "text": "ऑक्सीकरण अवस्था।"
  },
  {
    "start": 48.7,
    "end": 50.52,
    "text": "संक्रमण तत्वों में अलग-अलग"
  },
  {
    "start": 50.52,
    "end": 53.84,
    "text": "ऑक्सीकरण अवस्थाएँ मिलने का मुख्य कारण है"
  },
  {
    "start": 53.84,
    "end": 56.96,
    "text": "कि (n−1)d और ns कक्षकों की"
  },
  {
    "start": 56.96,
    "end": 59.48,
    "text": "ऊर्जाओं में बहुत अधिक अंतर नहीं होता।"
  },
  {
    "start": 59.62,
    "end": 62.56,
    "text": "इसलिए, बन्ध बनाने में केवल ns के"
  },
  {
    "start": 62.56,
    "end": 65.08,
    "text": "इलेक्ट्रॉन ही नहीं, बल्कि d-इलेक्ट्रॉन भी"
  },
  {
    "start": 65.08,
    "end": 66.08,
    "text": "भाग ले सकते हैं।"
  },
  {
    "start": 66.14,
    "end": 68.98,
    "text": "इसलिए, ये कई ऑक्सीकरण अवस्थाएँ दिखाते हैं।"
  },
  {
    "start": 68.98,
    "end": 71.34,
    "text": "अब यहाँ एक बहुत आम गलती होती है,"
  },
  {
    "start": 71.5,
    "end": 73.44,
    "text": "जो लगभग सब करते हैं।"
  },
  {
    "start": 73.5,
    "end": 76.1,
    "text": "Mn को सिर्फ +2 या +3 वाला"
  },
  {
    "start": 76.1,
    "end": 77.2,
    "text": "मत समझ लेना।"
  },
  {
    "start": 77.52,
    "end": 80.0,
    "text": "3d श्रेणी में Mn की उच्चतम"
  },
  {
    "start": 80.0,
    "end": 82.52,
    "text": "ऑक्सीकरण अवस्था +7 होती है,"
  },
  {
    "start": 82.68,
    "end": 84.52,
    "text": "क्योंकि Mn में सबसे अधिक"
  },
  {
    "start": 84.52,
    "end": 86.92,
    "text": "अयुग्मित d इलेक्ट्रॉन होते हैं।"
  },
  {
    "start": 86.92,
    "end": 90.3,
    "text": "उच्चतम ऑक्सीकरण अवस्थाएँ — +2, +3,"
  },
  {
    "start": 90.46,
    "end": 93.9,
    "text": "+4, +5, +6, और +7।"
  },
  {
    "start": 94.7,
    "end": 96.8,
    "text": "इसके बाद, Fe से Zn तक"
  },
  {
    "start": 96.8,
    "end": 99.08,
    "text": "उच्च ऑक्सीकरण अवस्थाओं की प्रवृत्ति"
  },
  {
    "start": 99.08,
    "end": 100.34,
    "text": "घटने लगती हैं।"
  },
  {
    "start": 100.34,
    "end": 102.18,
    "text": "बच्चों पहला गुण हो गया,"
  },
  {
    "start": 102.18,
    "end": 104.26,
    "text": "लेकिन अभी तीन और बाकी हैं।"
  },
  {
    "start": 104.26,
    "end": 107.28,
    "text": "पूरे आंसर के लिए पार्ट टू ज़रूर देखना,"
  },
  {
    "start": 107.28,
    "end": 109.7,
    "text": "क्योंकि अब अगला इम्पॉर्टेंट गुण शुरू होगा।"
  }
]