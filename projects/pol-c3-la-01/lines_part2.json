{
 "duration": 144.042688,
 "lines": [
  {
   "t0": 0.0,
   "t1": 0.45,
   "text": "बच्चों,"
  },
  {
   "t0": 0.45,
   "t1": 2.92,
   "text": "Part one में हमने हैदराबाद और जूनागढ़,"
  },
  {
   "t0": 2.92,
   "t1": 5.0,
   "text": "यानी रियासतों वाले दो कारण समझे।"
  },
  {
   "t0": 5.0,
   "t1": 7.51,
   "text": "लेकिन झगड़ा सिर्फ ज़मीन का नहीं था,"
  },
  {
   "t0": 7.51,
   "t1": 8.58,
   "text": "पैसों का भी था,"
  },
  {
   "t0": 8.58,
   "t1": 10.01,
   "text": "और यही है अगला कारण,"
  },
  {
   "t0": 10.01,
   "t1": 11.45,
   "text": "रिण अदायगी का विवाद।"
  },
  {
   "t0": 11.45,
   "t1": 13.6,
   "text": "तो हुआ ये कि आज़ादी के समय,"
  },
  {
   "t0": 13.6,
   "t1": 16.54,
   "text": "भारत ने ब्रिटिश भारत का पूरा रिण भार,"
  },
  {
   "t0": 16.54,
   "t1": 17.42,
   "text": "अपने ऊपर ले"
  },
  {
   "t0": 17.42,
   "t1": 17.99,
   "text": "लिया था,"
  },
  {
   "t0": 17.99,
   "t1": 19.85,
   "text": "और तय हुआ था कि पाकिस्तान,"
  },
  {
   "t0": 19.85,
   "t1": 22.35,
   "text": "अपने हिस्से का रिण भारत को चुकाएगा।"
  },
  {
   "t0": 22.35,
   "t1": 24.6,
   "text": "लेकिन पाकिस्तान इसे चुकाने में,"
  },
  {
   "t0": 24.6,
   "t1": 25.83,
   "text": "टालमटोल करता रहा।"
  },
  {
   "t0": 25.83,
   "t1": 28.08,
   "text": "इसी को लेकर शुरुआती दौर में ही,"
  },
  {
   "t0": 28.08,
   "t1": 30.84,
   "text": "दोनों के बीच आर्थिक और प्रशासनिक मतभेद"
  },
  {
   "t0": 31.2,
   "t1": 32.95,
   "text": "जिससे कड़वाहट और बढ़ गई।"
  },
  {
   "t0": 32.95,
   "t1": 34.56,
   "text": "आइए अब हम देखते हैं,"
  },
  {
   "t0": 34.56,
   "t1": 35.86,
   "text": "शरणार्थी समस्या,"
  },
  {
   "t0": 35.86,
   "t1": 38.2,
   "text": "ज़मीन और पैसे से भी बड़ी चोट,"
  },
  {
   "t0": 38.2,
   "t1": 39.09,
   "text": "उन परिवारों"
  },
  {
   "t0": 39.09,
   "t1": 39.73,
   "text": "को लगी,"
  },
  {
   "t0": 39.73,
   "t1": 43.2,
   "text": "जिन्हें रातों-रात अपना घर छोड़ना पड़ा,"
  },
  {
   "t0": 43.2,
   "t1": 45.03,
   "text": "और यहीं से खड़ी हुई,"
  },
  {
   "t0": 45.03,
   "t1": 45.76,
   "text": "शरणार्थी"
  },
  {
   "t0": 45.76,
   "t1": 46.33,
   "text": "समस्या।"
  },
  {
   "t0": 46.33,
   "t1": 49.7,
   "text": "विभाजन के समय भयंकर सांप्रदायिक दंगे हुए,"
  },
  {
   "t0": 49.7,
   "t1": 51.84,
   "text": "और लाखों शरणार्थी अपनी जान"
  },
  {
   "t0": 51.84,
   "t1": 52.34,
   "text": "बचाकर,"
  },
  {
   "t0": 52.34,
   "t1": 54.09,
   "text": "पाकिस्तान से भारत आए।"
  },
  {
   "t0": 54.09,
   "t1": 57.6,
   "text": "इसकी प्रतिक्रिया में भारत में भी दंगे हुए,"
  },
  {
   "t0": 57.77,
   "t1": 60.23,
   "text": "मुसलमान पाकिस्तान जाने लगे।"
  },
  {
   "t0": 60.23,
   "t1": 63.89,
   "text": "फर्क ये था कि भारत की धर्मनिरपेक्ष सरकार"
  },
  {
   "t0": 64.43,
   "t1": 66.35,
   "text": "नागरिकों की सुरक्षा की,"
  },
  {
   "t0": 66.35,
   "t1": 68.34,
   "text": "जबकि पाकिस्तान की सरकार,"
  },
  {
   "t0": 68.34,
   "t1": 70.09,
   "text": "वहाँ के अल्पसंख्यकों,"
  },
  {
   "t0": 70.42,
   "t1": 73.36,
   "text": "हिंदुओं और सिखों की रक्षा करने में,"
  },
  {
   "t0": 73.36,
   "t1": 74.12,
   "text": "विफल रही।"
  },
  {
   "t0": 74.12,
   "t1": 76.64,
   "text": "इसीलिए ये लोग अपनी जमीन-जायदाद"
  },
  {
   "t0": 76.64,
   "t1": 78.56,
   "text": "और सम्पत्ति वहीं छोड़कर,"
  },
  {
   "t0": 78.56,
   "t1": 80.31,
   "text": "भारत आने को मजबूर हुए,"
  },
  {
   "t0": 80.31,
   "t1": 83.51,
   "text": "और इसी मानवीय संकट और पुनर्वास की समस्या"
  },
  {
   "t0": 83.75,
   "t1": 85.82,
   "text": "दोनों देशों के रिश्तों को,"
  },
  {
   "t0": 85.82,
   "t1": 87.89,
   "text": "लंबे समय तक प्रभावित किया।"
  },
  {
   "t0": 87.89,
   "t1": 89.37,
   "text": "और इन सब में जो विवाद,"
  },
  {
   "t0": 89.37,
   "t1": 90.92,
   "text": "आगे चलकर सबसे बड़ा बना,"
  },
  {
   "t0": 90.92,
   "t1": 92.13,
   "text": "वही है आखिरी कारण,"
  },
  {
   "t0": 92.54,
   "t1": 93.22,
   "text": "समस्या।"
  },
  {
   "t0": 93.22,
   "t1": 97.21,
   "text": "कश्मीर भारत की उत्तर-पश्चिमी सीमा पर बसा,"
  },
  {
   "t0": 97.21,
   "t1": 99.35,
   "text": "एक रणनीतिक क्षेत्र है,"
  },
  {
   "t0": 99.74,
   "t1": 102.25,
   "text": "सुरक्षा के लिहाज़ से बहुत अहम।"
  },
  {
   "t0": 102.25,
   "t1": 105.1,
   "text": "और यहाँ के राजा हरि सिंह हिंदू थे,"
  },
  {
   "t0": 105.1,
   "t1": 106.27,
   "text": "जबकि ज़्यादातर"
  },
  {
   "t0": 106.27,
   "t1": 107.85,
   "text": "आबादी मुस्लिम थी।"
  },
  {
   "t0": 107.85,
   "t1": 111.09,
   "text": "फिर अक्टूबर उन्नीस सौ सैंतालीस में,"
  },
  {
   "t0": 111.09,
   "t1": 113.59,
   "text": "उत्तर-पश्चिम सीमा प्रांत के"
  },
  {
   "t0": 113.59,
   "t1": 115.3,
   "text": "कबायलियों की आड़ में,"
  },
  {
   "t0": 115.3,
   "t1": 118.49,
   "text": "पाकिस्तानी सैनिकों ने कश्मीर पर हमला कर"
  },
  {
   "t0": 119.3,
   "t1": 121.65,
   "text": "हमलावर श्रीनगर के करीब पहुँच गए,"
  },
  {
   "t0": 121.65,
   "t1": 124.37,
   "text": "तब महाराजा हरि सिंह ने भारत सरकार से,"
  },
  {
   "t0": 124.74,
   "t1": 125.72,
   "text": "सहायता माँगी,"
  },
  {
   "t0": 125.72,
   "t1": 128.04,
   "text": "और विलय-पत्र पर हस्ताक्षर करके,"
  },
  {
   "t0": 128.04,
   "t1": 130.51,
   "text": "जम्मू-कश्मीर के भारत में विलय को,"
  },
  {
   "t0": 130.51,
   "t1": 131.41,
   "text": "सहमति दे दी।"
  },
  {
   "t0": 131.41,
   "t1": 134.25,
   "text": "इसके बाद भारतीय सेना ने तुरंत पहुँचकर,"
  },
  {
   "t0": 134.25,
   "t1": 135.68,
   "text": "कश्मीर की रक्षा की।"
  },
  {
   "t0": 135.68,
   "t1": 137.62,
   "text": "तो कारण यहीं पूरे होते हैं,"
  },
  {
   "t0": 137.62,
   "t1": 138.71,
   "text": "पर answer नहीं,"
  },
  {
   "t0": 138.71,
   "t1": 141.3,
   "text": "क्योंकि उसकी सबसे ज़रूरी आखिरी लाइन,"
  },
  {
   "t0": 141.3,
   "t1": 142.6,
   "text": "Part three में है,"
  },
  {
   "t0": 142.6,
   "t1": 144.04,
   "text": "इसलिए उसे मत छोड़ना।"
  }
 ]
}