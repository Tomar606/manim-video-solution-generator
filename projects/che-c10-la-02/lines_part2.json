[
  {
    "start": 0.0,
    "end": 2.38,
    "text": "बच्चों, पार्ट वन में हमने डेफिनेशन"
  },
  {
    "start": 2.38,
    "end": 3.92,
    "text": "और क्लासिफिकेशन तो कर लिया।"
  },
  {
    "start": 4.1,
    "end": 5.48,
    "text": "अब वो हिस्सा करते हैं"
  },
  {
    "start": 5.48,
    "end": 7.64,
    "text": "जहां सबसे ज्यादा कन्फ्यूजन होता है।"
  },
  {
    "start": 7.84,
    "end": 10.26,
    "text": "रोग और विटामिन का सही कनेक्शन।"
  },
  {
    "start": 10.26,
    "end": 12.12,
    "text": "और ध्यान से करना, कई बार"
  },
  {
    "start": 12.12,
    "end": 13.74,
    "text": "बच्चे A, D और K, C को"
  },
  {
    "start": 13.74,
    "end": 15.58,
    "text": "आपस में उल्टे लिख देते हैं।"
  },
  {
    "start": 15.72,
    "end": 18.54,
    "text": "पहला, खून का थक्का न जमने की समस्या"
  },
  {
    "start": 18.54,
    "end": 20.42,
    "text": "किस विटामिन की कमी से होती है?"
  },
  {
    "start": 20.46,
    "end": 21.84,
    "text": "याद रखने के लिए K को"
  },
  {
    "start": 21.84,
    "end": 23.26,
    "text": "थक्का जमने से जोड़ लो,"
  },
  {
    "start": 23.26,
    "end": 24.58,
    "text": "K मतलब थक्का।"
  },
  {
    "start": 25.56,
    "end": 28.08,
    "text": "अब दूसरा, रतौंधी यानी"
  },
  {
    "start": 28.08,
    "end": 29.94,
    "text": "आँखों से जुड़ी समस्या,"
  },
  {
    "start": 29.94,
    "end": 32.18,
    "text": "ये किस विटामिन की कमी से होती है।"
  },
  {
    "start": 32.18,
    "end": 33.7,
    "text": "इसे ध्यान से याद रखना,"
  },
  {
    "start": 33.7,
    "end": 35.46,
    "text": "एग्जाम में रतौंधी दिखे तो"
  },
  {
    "start": 35.46,
    "end": 37.58,
    "text": "A तुरंत याद आना चाहिए।"
  },
  {
    "start": 37.58,
    "end": 41.58,
    "text": "तीसरा, रक्ताल्पता, खासकर प्रणाशी रक्ताल्पता,"
  },
  {
    "start": 41.68,
    "end": 43.58,
    "text": "ये किस विटामिन की कमी से होती है?"
  },
  {
    "start": 43.6,
    "end": 46.04,
    "text": "इतना तो हो गया, अब आगे देखते हैं।"
  },
  {
    "start": 46.22,
    "end": 48.84,
    "text": "चौथा, सूखा रोग, यानी रिकेट्स,"
  },
  {
    "start": 48.84,
    "end": 50.84,
    "text": "ये किस विटामिन की कमी से होता है?"
  },
  {
    "start": 50.84,
    "end": 52.62,
    "text": "याद रखो, D को धूप"
  },
  {
    "start": 52.62,
    "end": 54.42,
    "text": "और मज़बूत हड्डियों से जोड़ लो।"
  },
  {
    "start": 54.72,
    "end": 57.24,
    "text": "पाँचवाँ, पायरिया, यानी स्कर्वी,"
  },
  {
    "start": 57.36,
    "end": 58.96,
    "text": "मसूड़ों से खून आना और"
  },
  {
    "start": 58.96,
    "end": 60.32,
    "text": "घाव देर से भरना,"
  },
  {
    "start": 60.38,
    "end": 62.36,
    "text": "ये किस विटामिन की कमी से होता है?"
  },
  {
    "start": 62.68,
    "end": 64.58,
    "text": "अब छठा, बन्ध्यता, ये किस"
  },
  {
    "start": 64.58,
    "end": 66.44,
    "text": "विटामिन की कमी से होती है?"
  },
  {
    "start": 67.62,
    "end": 69.58,
    "text": "और आखिरी, अरक्तता,"
  },
  {
    "start": 69.58,
    "end": 71.22,
    "text": "यहाँ थोड़ा ध्यान देना क्योंकि"
  },
  {
    "start": 71.22,
    "end": 72.62,
    "text": "यहीं गलती हो सकती है,"
  },
  {
    "start": 72.62,
    "end": 74.0,
    "text": "B6 मत लिखना, क्योंकि"
  },
  {
    "start": 74.0,
    "end": 75.88,
    "text": "यह आक्षेप से जुड़ा है।"
  },
  {
    "start": 75.88,
    "end": 77.5,
    "text": "चलो अब पूरी टेबल को"
  },
  {
    "start": 77.5,
    "end": 79.52,
    "text": "एक आसान ट्रिक से दिमाग में बैठा लो।"
  },
  {
    "start": 79.52,
    "end": 81.2,
    "text": "A मतलब आँख, D मतलब"
  },
  {
    "start": 81.2,
    "end": 82.94,
    "text": "धूप और हड्डियाँ, और"
  },
  {
    "start": 82.94,
    "end": 85.7,
    "text": "E मतलब बन्ध्यता, K मतलब थक्का,"
  },
  {
    "start": 85.74,
    "end": 89.42,
    "text": "C मतलब स्कर्वी, B12 मतलब रक्ताल्पता,"
  },
  {
    "start": 89.62,
    "end": 92.38,
    "text": "और फोलिक अम्ल मतलब अरक्तता।"
  },
  {
    "start": 92.38,
    "end": 94.64,
    "text": "अब इस पूरे आंसर में डेफिनेशन,"
  },
  {
    "start": 94.88,
    "end": 97.02,
    "text": "वर्गीकरण और ये सारे बीमारी"
  },
  {
    "start": 97.02,
    "end": 98.22,
    "text": "और विटामिन के कनेक्शन"
  },
  {
    "start": 98.22,
    "end": 99.99,
    "text": "से एग्जाम में लिखने हैं।"
  },
  {
    "start": 99.99,
    "end": 102.33,
    "text": "इतना समझ लिया, अब बारी है"
  },
  {
    "start": 102.33,
    "end": 104.57,
    "text": "इसे परीक्षा में सही तरीके से लिखने की,"
  },
  {
    "start": 104.75,
    "end": 107.11,
    "text": "इसका पूरा आंसर राइट साइड में"
  },
  {
    "start": 107.11,
    "end": 108.71,
    "text": "दिये नोट्स बटन में मिल जाएगा,"
  },
  {
    "start": 108.93,
    "end": 110.09,
    "text": "और फिर आगे की पढ़ाई वाली"
  },
  {
    "start": 110.09,
    "end": 111.57,
    "text": "रील्स भी देखते रहना,"
  },
  {
    "start": 111.71,
    "end": 113.41,
    "text": "एक-एक करके सिलेबस कम्प्लीट करो"
  },
  {
    "start": 113.41,
    "end": 115.79,
    "text": "और नब्बे प्रतिशत तैयारी पक्की करो।"
  }
]