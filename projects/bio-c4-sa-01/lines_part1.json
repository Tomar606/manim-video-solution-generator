[
 {
  "start": 0.0,
  "end": 1.24,
  "text": "MP Board कक्षा"
 },
 {
  "start": 1.24,
  "end": 2.04,
  "text": "बारहवीं के बच्चों"
 },
 {
  "start": 2.04,
  "end": 3.68,
  "text": "ये सवाल दो हज़ार पच्चीस में"
 },
 {
  "start": 3.68,
  "end": 5.24,
  "text": "board exam में पूछा गया है,"
 },
 {
  "start": 5.24,
  "end": 7.36,
  "text": "और इस साल भी आपकी"
 },
 {
  "start": 7.36,
  "end": 8.22,
  "text": "परीक्षा में आ सकता है।"
 },
 {
  "start": 8.22,
  "end": 9.84,
  "text": "सवाल है, वंशावली"
 },
 {
  "start": 9.84,
  "end": 11.28,
  "text": "विश्लेषण क्या है?"
 },
 {
  "start": 11.28,
  "end": 12.16,
  "text": "यह विश्लेषण किस"
 },
 {
  "start": 12.16,
  "end": 13.44,
  "text": "प्रकार उपयोगी है?"
 },
 {
  "start": 13.44,
  "end": 14.62,
  "text": "तो बच्चों ये 3"
 },
 {
  "start": 14.62,
  "end": 15.42,
  "text": "नंबर का सवाल है,"
 },
 {
  "start": 15.42,
  "end": 16.88,
  "text": "तो आज इसका पूरा answer"
 },
 {
  "start": 16.88,
  "end": 18.6,
  "text": "अच्छे से clear कर लेते हैं।"
 },
 {
  "start": 18.6,
  "end": 19.96,
  "text": "सबसे पहले Pedigree यानी,"
 },
 {
  "start": 19.96,
  "end": 21.6,
  "text": "वंशावली को समझते हैं,"
 },
 {
  "start": 21.6,
  "end": 23.52,
  "text": "जब किसी आनुवंशिक"
 },
 {
  "start": 23.52,
  "end": 24.62,
  "text": "विशेषक यानी, Trait का,"
 },
 {
  "start": 24.62,
  "end": 26.9,
  "text": "दो या दो से अधिक पीढ़ियों में,"
 },
 {
  "start": 26.9,
  "end": 30.02,
  "text": "वंशवृक्ष या आरेख के रूप में"
 },
 {
  "start": 30.02,
  "end": 31.42,
  "text": "अभिलेख तैयार किया जाता है,"
 },
 {
  "start": 31.42,
  "end": 32.64,
  "text": "तो उसे वंशावली या"
 },
 {
  "start": 32.64,
  "end": 33.9,
  "text": "Pedigree कहते हैं।"
 },
 {
  "start": 33.9,
  "end": 36.24,
  "text": "मतलब आसान भाषा में समझे तो,"
 },
 {
  "start": 36.24,
  "end": 37.94,
  "text": "एक family में कोई particular"
 },
 {
  "start": 37.94,
  "end": 40.54,
  "text": "trait या आनुवंशिक विकार,"
 },
 {
  "start": 40.54,
  "end": 41.4,
  "text": "कई पीढ़ियों में किस-किस"
 },
 {
  "start": 41.4,
  "end": 42.78,
  "text": "व्यक्ति में दिखाई दे रहा है,"
 },
 {
  "start": 42.78,
  "end": 44.12,
  "text": "उसका रिकॉर्ड हम pedigree"
 },
 {
  "start": 44.12,
  "end": 45.44,
  "text": "के रूप में बनाते हैं।"
 },
 {
  "start": 45.44,
  "end": 47.06,
  "text": "अच्छा, अब इसी"
 },
 {
  "start": 47.06,
  "end": 48.7,
  "text": "रिकॉर्ड से आगे समझो,"
 },
 {
  "start": 48.7,
  "end": 49.5,
  "text": "कई पीढ़ियों में किसी"
 },
 {
  "start": 49.5,
  "end": 52.36,
  "text": "लक्षण की वंशागति यानी,"
 },
 {
  "start": 52.36,
  "end": 53.86,
  "text": "Inheritance का अध्ययन करना ही,"
 },
 {
  "start": 53.86,
  "end": 54.86,
  "text": "वंशावली विश्लेषण यानी,"
 },
 {
  "start": 54.86,
  "end": 56.88,
  "text": "Pedigree एनालिसिस कहलाता है।"
 },
 {
  "start": 56.88,
  "end": 58.98,
  "text": "अब एक बात और ध्यान रखना,"
 },
 {
  "start": 58.98,
  "end": 60.62,
  "text": "जिस trait का अध्ययन"
 },
 {
  "start": 60.62,
  "end": 61.56,
  "text": "किया जाता है,"
 },
 {
  "start": 61.56,
  "end": 63.74,
  "text": "वह किसी आनुवंशिक या चिकित्सकीय"
 },
 {
  "start": 63.74,
  "end": 65.68,
  "text": "विकार से संबंधित हो सकता है।"
 },
 {
  "start": 65.68,
  "end": 67.18,
  "text": "और जरूरी नहीं कि हर"
 },
 {
  "start": 67.18,
  "end": 68.84,
  "text": "trait कोई बीमारी ही हो,"
 },
 {
  "start": 68.84,
  "end": 70.88,
  "text": "कुछ सामान्य traits का भी"
 },
 {
  "start": 70.88,
  "end": 72.04,
  "text": "अध्ययन किया जा सकता है,"
 },
 {
  "start": 72.04,
  "end": 73.82,
  "text": "जैसे जीभ को रोल करना।"
 },
 {
  "start": 73.82,
  "end": 75.58,
  "text": "चलो अब बात करते हैं वंशावली"
 },
 {
  "start": 75.58,
  "end": 77.26,
  "text": "विश्लेषण के महत्व की, और इन"
 },
 {
  "start": 77.26,
  "end": 78.06,
  "text": "तीनों को अच्छे से"
 },
 {
  "start": 78.06,
  "end": 79.36,
  "text": "दिमाग में बैठा लेना।"
 },
 {
  "start": 79.36,
  "end": 80.62,
  "text": "तो पहला महत्व है कि"
 },
 {
  "start": 80.62,
  "end": 82.32,
  "text": "मनुष्यों में, ethical"
 },
 {
  "start": 82.32,
  "end": 83.66,
  "text": "यानी, नैतिक और"
 },
 {
  "start": 83.66,
  "end": 84.46,
  "text": "biological यानी, जैविक"
 },
 {
  "start": 84.46,
  "end": 86.0,
  "text": "कारणों से, तुलनार्थ,"
 },
 {
  "start": 86.0,
  "end": 86.865,
  "text": "संकरण यानी,"
 },
 {
  "start": 86.865,
  "end": 88.28,
  "text": "controlled crosses"
 },
 {
  "start": 88.28,
  "end": 89.5,
  "text": "नहीं कराए जा सकते।"
 },
 {
  "start": 89.5,
  "end": 91.32,
  "text": "इसलिए मनुष्य के"
 },
 {
  "start": 91.32,
  "end": 92.58,
  "text": "आनुवंशिक लक्षणों और"
 },
 {
  "start": 92.58,
  "end": 93.76,
  "text": "आनुवंशिक विकारों की वंशागति"
 },
 {
  "start": 93.76,
  "end": 95.701,
  "text": "का अध्ययन करने के लिए,"
 },
 {
  "start": 95.701,
  "end": 97.2,
  "text": "pedigree एनालिसिस"
 },
 {
  "start": 97.2,
  "end": 98.04,
  "text": "बहुत useful तरीका है।"
 },
 {
  "start": 98.04,
  "end": 99.72,
  "text": "अब दूसरा महत्व देखते हैं,"
 },
 {
  "start": 99.72,
  "end": 101.38,
  "text": "और इसमें वंशावली का अध्ययन"
 },
 {
  "start": 101.38,
  "end": 102.96,
  "text": "करके, दम्पत्तियों को,"
 },
 {
  "start": 102.96,
  "end": 104.299,
  "text": "उनके होने वाले बच्चों"
 },
 {
  "start": 104.299,
  "end": 105.32,
  "text": "में कुछ आनुवंशिक"
 },
 {
  "start": 105.32,
  "end": 107.1,
  "text": "असामान्यताओं की"
 },
 {
  "start": 107.1,
  "end": 107.92,
  "text": "संभावना के बारे में,"
 },
 {
  "start": 107.92,
  "end": 110.374,
  "text": "पहले से जानकारी दी जा सकती है।"
 },
 {
  "start": 110.374,
  "end": 112.5,
  "text": "मतलब family history देखकर,"
 },
 {
  "start": 112.5,
  "end": 114.18,
  "text": "आनुवंशिक विकार के inheritance"
 },
 {
  "start": 114.18,
  "end": 114.98,
  "text": "pattern को समझने"
 },
 {
  "start": 114.98,
  "end": 116.06,
  "text": "में मदद मिलती है,"
 },
 {
  "start": 116.06,
  "end": 117.38,
  "text": "और संभावित risk के बारे"
 },
 {
  "start": 117.38,
  "end": 119.56,
  "text": "में जानकारी दी जा सकती है।"
 },
 {
  "start": 119.56,
  "end": 122.06,
  "text": "अब तीसरा और आखिरी महत्व,"
 },
 {
  "start": 122.06,
  "end": 124.04,
  "text": "वंशावली विश्लेषण से,"
 },
 {
  "start": 124.04,
  "end": 125.8,
  "text": "मनुष्य में लिंग-सहलग्न"
 },
 {
  "start": 125.8,
  "end": 127.28,
  "text": "रोगों यानी Sex-linked"
 },
 {
  "start": 127.28,
  "end": 129.16,
  "text": "Disorders की वंशागति को"
 },
 {
  "start": 129.16,
  "end": 131.48,
  "text": "समझने में भी बहुत मदद मिली है।"
 },
 {
  "start": 131.48,
  "end": 133.2,
  "text": "तो बच्चों, ये तीनों महत्व"
 },
 {
  "start": 133.2,
  "end": 135.42,
  "text": "exam में अच्छे से लिख दिए,"
 },
 {
  "start": 135.42,
  "end": 136.68,
  "text": "तो 3 नंबर पक्के समझो।"
 },
 {
  "start": 136.68,
  "end": 137.84,
  "text": "अब इसका answer exam"
 },
 {
  "start": 137.84,
  "end": 138.78,
  "text": "में कैसे लिखना है,"
 },
 {
  "start": 138.78,
  "end": 139.98,
  "text": "वो आपकी screen"
 },
 {
  "start": 139.98,
  "end": 141.08,
  "text": "के right side में"
 },
 {
  "start": 141.08,
  "end": 141.94,
  "text": "दिए Notes button पर मिल जाएगा।"
 },
 {
  "start": 141.94,
  "end": 144.24,
  "text": "बस, ऐसे ही एक-एक"
 },
 {
  "start": 144.24,
  "end": 145.04,
  "text": "topic clear करते जाओ,"
 },
 {
  "start": 145.04,
  "end": 146.91,
  "text": "और सिलेबस पूरा करते जाओ।"
 }
]