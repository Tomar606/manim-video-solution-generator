[
 {
  "start": 1.18,
  "end": 2.48,
  "text": "बच्चों, Part one में पहली"
 },
 {
  "start": 2.48,
  "end": 3.78,
  "text": "दो अभिक्रियाएँ कर ली थीं।"
 },
 {
  "start": 3.78,
  "end": 5.82,
  "text": "अब तीसरी अभिक्रिया पर आते हैं,"
 },
 {
  "start": 5.82,
  "end": 7.26,
  "text": "और यहाँ थोड़ा ध्यान देना,"
 },
 {
  "start": 7.26,
  "end": 8.82,
  "text": "क्योंकि अब इसी अभिक्रिया से"
 },
 {
  "start": 8.82,
  "end": 10.38,
  "text": "आगे की calculation समझेंगे,"
 },
 {
  "start": 10.38,
  "end": 11.51,
  "text": "और यहाँ अक्सर बच्चे"
 },
 {
  "start": 11.51,
  "end": 12.58,
  "text": "कन्फ्यूज होते हैं।"
 },
 {
  "start": 12.58,
  "end": 14.015,
  "text": "चलो, तीसरी अभिक्रिया"
 },
 {
  "start": 14.015,
  "end": 15.02,
  "text": "शुरू करते हैं।"
 },
 {
  "start": 15.02,
  "end": 16.059,
  "text": "इस अभिक्रिया में,"
 },
 {
  "start": 16.059,
  "end": 17.22,
  "text": "C H three C H O से,"
 },
 {
  "start": 17.22,
  "end": 21.48,
  "text": "C H four और C O बनते हैं,"
 },
 {
  "start": 21.48,
  "end": 23.34,
  "text": "और इसका वेग व्यंजक है,"
 },
 {
  "start": 23.34,
  "end": 26.321,
  "text": "C H three C H O की सांद्रता"
 },
 {
  "start": 26.321,
  "end": 28.75,
  "text": "की घात है, तीन बटे दो,"
 },
 {
  "start": 28.96,
  "end": 29.75,
  "text": "इसलिए अभिक्रिया की कुल कोटि,"
 },
 {
  "start": 29.75,
  "end": 30.54,
  "text": "तीन बटे दो, यानी, डेढ़ होगी।"
 },
 {
  "start": 30.54,
  "end": 32.55,
  "text": "अब एक important बात,"
 },
 {
  "start": 32.55,
  "end": 35.589,
  "text": "अभिक्रिया की कोटि हमेशा"
 },
 {
  "start": 35.589,
  "end": 38.1,
  "text": "पूर्णांक में ही हो,"
 },
 {
  "start": 38.1,
  "end": 38.67,
  "text": "ऐसा आवश्यक नहीं है।"
 },
 {
  "start": 38.67,
  "end": 39.25,
  "text": "यह भिन्नात्मक भी हो सकती है।"
 },
 {
  "start": 39.25,
  "end": 40.61,
  "text": "इसलिए तीसरी अभिक्रिया"
 },
 {
  "start": 40.61,
  "end": 42.1,
  "text": "की कोटि है, तीन बटे दो।"
 },
 {
  "start": 42.1,
  "end": 45.131,
  "text": "अब यहाँ वेग स्थिरांक की"
 },
 {
  "start": 45.131,
  "end": 48.69,
  "text": "इकाई निकालने का तरीका समझो,"
 },
 {
  "start": 49.72,
  "end": 51.171,
  "text": "क्योंकि यही जगह सबसे"
 },
 {
  "start": 51.171,
  "end": 52.84,
  "text": "ज्यादा confuse करती है।"
 },
 {
  "start": 52.84,
  "end": 53.82,
  "text": "तो हम जानते हैं कि,"
 },
 {
  "start": 53.82,
  "end": 54.331,
  "text": "तीसरी अभिक्रिया की कोटि,"
 },
 {
  "start": 54.331,
  "end": 54.8,
  "text": "n बराबर तीन बटे दो है।"
 },
 {
  "start": 54.8,
  "end": 59.08,
  "text": "इसलिए,"
 },
 {
  "start": 59.08,
  "end": 59.579,
  "text": "यहाँ ऊपर, मोल लीटर"
 },
 {
  "start": 59.579,
  "end": 60.3,
  "text": "inverse सेकण्ड inverse है,"
 },
 {
  "start": 60.3,
  "end": 62.446,
  "text": "और नीचे, मोल लीटर"
 },
 {
  "start": 62.446,
  "end": 64.34,
  "text": "inverse की घात,"
 },
 {
  "start": 64.34,
  "end": 65.74,
  "text": "तीन बटे दो है।"
 },
 {
  "start": 65.74,
  "end": 68.12,
  "text": "अब घात को simplify करने पर,"
 },
 {
  "start": 68.12,
  "end": 70.1,
  "text": "इसकी वेग स्थिरांक की unit हैं,"
 },
 {
  "start": 70.1,
  "end": 71.33,
  "text": "लीटर की घात one by two,"
 },
 {
  "start": 71.56,
  "end": 73.197,
  "text": "मोल की घात minus one"
 },
 {
  "start": 73.197,
  "end": 75.08,
  "text": "by two, सेकण्ड inverse।"
 },
 {
  "start": 75.08,
  "end": 76.791,
  "text": "यानी, तीसरी अभिक्रिया"
 },
 {
  "start": 76.791,
  "end": 78.34,
  "text": "की कोटि तीन बटे दो,"
 },
 {
  "start": 78.34,
  "end": 80.2,
  "text": "और वेग स्थिरांक की इकाई,"
 },
 {
  "start": 80.2,
  "end": 81.29,
  "text": "लीटर की घात one by two,"
 },
 {
  "start": 81.78,
  "end": 82.436,
  "text": "मोल की घात minus one"
 },
 {
  "start": 82.436,
  "end": 83.19,
  "text": "by two, सेकण्ड inverse।"
 },
 {
  "start": 84.58,
  "end": 85.642,
  "text": "तो यहाँ से एक चीज"
 },
 {
  "start": 85.642,
  "end": 86.58,
  "text": "और clear हो गई,"
 },
 {
  "start": 86.58,
  "end": 88.941,
  "text": "यदि कोटि भिन्नात्मक है, तो"
 },
 {
  "start": 88.941,
  "end": 91.12,
  "text": "वेग स्थिरांक की इकाई भी,"
 },
 {
  "start": 91.12,
  "end": 93.275,
  "text": "उसी के अनुसार भिन्नात्मक"
 },
 {
  "start": 93.275,
  "end": 95.16,
  "text": "घातों में हो सकती है।"
 },
 {
  "start": 95.16,
  "end": 97.02,
  "text": "बच्चों, यहाँ तक तो समझ गए,"
 },
 {
  "start": 97.02,
  "end": 98.309,
  "text": "अब चौथी और आखिरी"
 },
 {
  "start": 98.309,
  "end": 99.92,
  "text": "अभिक्रिया देखते हैं।"
 },
 {
  "start": 100.42,
  "end": 102.2,
  "text": "अब यहाँ, C two H five C l से,"
 },
 {
  "start": 102.2,
  "end": 103.705,
  "text": "C two H four और"
 },
 {
  "start": 103.705,
  "end": 105.21,
  "text": "H C l बनने वाली"
 },
 {
  "start": 105.21,
  "end": 106.51,
  "text": "अभिक्रिया को देखते हैं,"
 },
 {
  "start": 106.51,
  "end": 108.62,
  "text": "और इसका वेग व्यंजक में,"
 },
 {
  "start": 109.93,
  "end": 110.966,
  "text": "C two H five C l की"
 },
 {
  "start": 110.966,
  "end": 112.11,
  "text": "सांद्रता की घात 1 है।"
 },
 {
  "start": 112.11,
  "end": 113.654,
  "text": "इसलिए इसकी अभिक्रिया की"
 },
 {
  "start": 113.654,
  "end": 115.13,
  "text": "कोटि होगी, प्रथम कोटि।"
 },
 {
  "start": 115.13,
  "end": 116.63,
  "text": "और प्रथम कोटि के लिए,"
 },
 {
  "start": 116.63,
  "end": 117.58,
  "text": "वेग स्थिरांक की इकाई"
 },
 {
  "start": 117.58,
  "end": 118.72,
  "text": "होती है, सेकण्ड inverse।"
 },
 {
  "start": 119.65,
  "end": 120.791,
  "text": "इसे भी formula से"
 },
 {
  "start": 120.791,
  "end": 122.0,
  "text": "check कर सकते हैं,"
 },
 {
  "start": 122.69,
  "end": 124.05,
  "text": "अर्थात्, प्रथम कोटि में,"
 },
 {
  "start": 124.05,
  "end": 126.033,
  "text": "सांद्रता की इकाई पूरी"
 },
 {
  "start": 126.033,
  "end": 128.11,
  "text": "तरह निरस्त हो जाती है,"
 },
 {
  "start": 128.11,
  "end": 129.426,
  "text": "और केवल सेकण्ड"
 },
 {
  "start": 129.426,
  "end": 130.93,
  "text": "inverse बचता है।"
 },
 {
  "start": 130.93,
  "end": 131.74,
  "text": "तो बच्चों, अब पूरा"
 },
 {
  "start": 131.74,
  "end": 132.91,
  "text": "concept अच्छे से clear है।"
 },
 {
  "start": 132.91,
  "end": 134.774,
  "text": "इसे exam में सही"
 },
 {
  "start": 134.774,
  "end": 136.87,
  "text": "तरीके से लिख दिया,"
 },
 {
  "start": 136.87,
  "end": 138.65,
  "text": "तो 3 नंबर पक्के,"
 },
 {
  "start": 138.65,
  "end": 140.15,
  "text": "और वो कैसे लिखना है,"
 },
 {
  "start": 140.15,
  "end": 141.225,
  "text": "इसका exact answer"
 },
 {
  "start": 141.225,
  "end": 142.173,
  "text": "आपकी screen में"
 },
 {
  "start": 142.173,
  "end": 144.07,
  "text": "दिए Notes button पर मिल जाएगा।"
 },
 {
  "start": 144.07,
  "end": 145.68,
  "text": "ऐसे ही एक-एक question"
 },
 {
  "start": 145.68,
  "end": 146.83,
  "text": "clear करते जाओ,"
 },
 {
  "start": 146.83,
  "end": 149.03,
  "text": "और अपनी तैयारी मजबूत करते जाओ।"
 }
