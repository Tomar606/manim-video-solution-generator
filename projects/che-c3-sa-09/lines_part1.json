[
 {
  "start": 0.0,
  "end": 1.374,
  "text": "MP Board कक्षा"
 },
 {
  "start": 1.374,
  "end": 3.14,
  "text": "बारहवीं के बच्चों,"
 },
 {
  "start": 3.14,
  "end": 5.05,
  "text": "ये सवाल 2023 में Board"
 },
 {
  "start": 5.05,
  "end": 7.22,
  "text": "Exam में पूछा जा चुका है,"
 },
 {
  "start": 7.22,
  "end": 8.746,
  "text": "और इस बार भी आपकी"
 },
 {
  "start": 8.746,
  "end": 10.72,
  "text": "परीक्षा में आ सकता है।"
 },
 {
  "start": 10.72,
  "end": 11.7,
  "text": "आज इस सवाल को ऐसे समझेंगे,"
 },
 {
  "start": 11.7,
  "end": 12.427,
  "text": "कि 3 नंबर के answer"
 },
 {
  "start": 12.427,
  "end": 13.23,
  "text": "में कोई point न छूटे।"
 },
 {
  "start": 13.23,
  "end": 17.93,
  "text": "तो पहले एक basic rule याद रखो,"
 },
 {
  "start": 17.96,
  "end": 19.557,
  "text": "वेग व्यंजक में, सांद्रता"
 },
 {
  "start": 19.557,
  "end": 21.02,
  "text": "की घातों को जोड़ने पर,"
 },
 {
  "start": 21.02,
  "end": 22.041,
  "text": "अभिक्रिया की कुल"
 },
 {
  "start": 22.041,
  "end": 23.38,
  "text": "कोटि प्राप्त होती है।"
 },
 {
  "start": 23.38,
  "end": 24.243,
  "text": "बस, अब इसी rule को चारों"
 },
 {
  "start": 24.243,
  "end": 25.07,
  "text": "अभिक्रियाओ पर लगाना है।"
 },
 {
  "start": 25.07,
  "end": 27.809,
  "text": "चलो, पहली अभिक्रिया"
 },
 {
  "start": 27.809,
  "end": 30.26,
  "text": "से शुरू करते हैं।"
 },
 {
  "start": 30.26,
  "end": 31.79,
  "text": "इस अभिक्रिया का वेग"
 },
 {
  "start": 31.79,
  "end": 33.32,
  "text": "व्यंजक दिया गया है।"
 },
 {
  "start": 33.32,
  "end": 35.245,
  "text": "यहाँ N O की सांद्रता"
 },
 {
  "start": 35.245,
  "end": 36.4,
  "text": "की घात 2 है।"
 },
 {
  "start": 36.4,
  "end": 38.426,
  "text": "इसलिए इसकी अभिक्रिया की"
 },
 {
  "start": 38.426,
  "end": 40.54,
  "text": "कोटि होगी, द्वितीय कोटि।"
 },
 {
  "start": 40.54,
  "end": 41.682,
  "text": "और द्वितीय कोटि की"
 },
 {
  "start": 41.682,
  "end": 42.76,
  "text": "अभिक्रिया के लिए,"
 },
 {
  "start": 42.76,
  "end": 45.11,
  "text": "वेग स्थिरांक की इकाई होती है,"
 },
 {
  "start": 46.04,
  "end": 47.55,
  "text": "लीटर, मोल की घात माइनस एक,"
 },
 {
  "start": 48.3,
  "end": 49.1,
  "text": "सेकण्ड की घात माइनस एक।"
 },
 {
  "start": 50.96,
  "end": 52.106,
  "text": "तो पहली अभिक्रिया"
 },
 {
  "start": 52.106,
  "end": 53.05,
  "text": "का answer हुआ,"
 },
 {
  "start": 53.54,
  "end": 54.38,
  "text": "द्वितीय कोटि, तथा लीटर,"
 },
 {
  "start": 54.38,
  "end": 55.18,
  "text": "मोल की घात माइनस एक,"
 },
 {
  "start": 55.18,
  "end": 56.65,
  "text": "सेकण्ड की घात माइनस एक।"
 },
 {
  "start": 58.66,
  "end": 59.592,
  "text": "अब यहाँ एक बात"
 },
 {
  "start": 59.592,
  "end": 60.79,
  "text": "बहुत important है,"
 },
 {
  "start": 61.5,
  "end": 62.83,
  "text": "अभिक्रिया की कोटि निकालते समय,"
 },
 {
  "start": 64.02,
  "end": 65.58,
  "text": "रासायनिक समीकरण में दिए गए"
 },
 {
  "start": 65.58,
  "end": 67.2,
  "text": "गुणांकों को नहीं जोड़ना है।"
 },
 {
  "start": 67.2,
  "end": 69.392,
  "text": "केवल वेग व्यंजक में, सांद्रता"
 },
 {
  "start": 69.392,
  "end": 70.98,
  "text": "की घातों को देखना है।"
 },
 {
  "start": 70.98,
  "end": 71.918,
  "text": "चलो अब आते हैं"
 },
 {
  "start": 71.918,
  "end": 73.19,
  "text": "दूसरी अभिक्रिया पर।"
 },
 {
  "start": 73.54,
  "end": 75.51,
  "text": "इसमें H two O two,"
 },
 {
  "start": 76.14,
  "end": 78.16,
  "text": "I माइनस और H प्लस मौजूद हैं।"
 },
 {
  "start": 78.16,
  "end": 79.628,
  "text": "लेकिन यहाँ H two"
 },
 {
  "start": 79.628,
  "end": 81.28,
  "text": "O two की घात 1 है,"
 },
 {
  "start": 81.28,
  "end": 83.44,
  "text": "और I माइनस की घात भी 1 है।"
 },
 {
  "start": 83.44,
  "end": 84.905,
  "text": "तो कुल कोटि होगी,"
 },
 {
  "start": 84.905,
  "end": 86.37,
  "text": "1 प्लस 1 बराबर 2।"
 },
 {
  "start": 86.82,
  "end": 88.08,
  "text": "इसलिए इसकी अभिक्रिया की"
 },
 {
  "start": 88.08,
  "end": 89.56,
  "text": "कोटि भी होगी, द्वितीय कोटि।"
 },
 {
  "start": 89.56,
  "end": 91.88,
  "text": "और इसकी इकाई भी होगी, लीटर,"
 },
 {
  "start": 91.88,
  "end": 93.354,
  "text": "मोल की घात माइनस एक,"
 },
 {
  "start": 93.354,
  "end": 95.05,
  "text": "सेकण्ड की घात माइनस एक।"
 },
 {
  "start": 95.36,
  "end": 96.322,
  "text": "तो बच्चों, इसका"
 },
 {
  "start": 96.322,
  "end": 97.54,
  "text": "मतलब पहली और दूसरी,"
 },
 {
  "start": 97.54,
  "end": 99.14,
  "text": "दोनों अभिक्रियाओं की"
 },
 {
  "start": 99.14,
  "end": 100.9,
  "text": "कोटि, द्वितीय कोटि आई।"
 },
 {
  "start": 100.9,
  "end": 102.015,
  "text": "लेकिन यहाँ एक और"
 },
 {
  "start": 102.015,
  "end": 103.06,
  "text": "बात ध्यान रखना,"
 },
 {
  "start": 103.06,
  "end": 104.883,
  "text": "रासायनिक समीकरण में H"
 },
 {
  "start": 104.883,
  "end": 106.62,
  "text": "प्लस भी दिया गया है,"
 },
 {
  "start": 106.62,
  "end": 108.028,
  "text": "लेकिन वेग व्यंजक"
 },
 {
  "start": 108.028,
  "end": 109.7,
  "text": "में H प्लस नहीं है।"
 },
 {
  "start": 109.7,
  "end": 110.21,
  "text": "इसलिए कोटि निकालते समय, H"
 },
 {
  "start": 110.21,
  "end": 110.74,
  "text": "प्लस को शामिल नहीं करेंगे।"
 },
 {
  "start": 110.74,
  "end": 112.345,
  "text": "यानी, बच्चों, अभिक्रिया"
 },
 {
  "start": 112.345,
  "end": 114.02,
  "text": "में कोई पदार्थ मौजूद है,"
 },
 {
  "start": 114.02,
  "end": 118.16,
  "text": "इसका मतलब ये जरूरी नहीं,"
 },
 {
  "start": 118.16,
  "end": 119.31,
  "text": "कि वह वेग व्यंजक"
 },
 {
  "start": 119.31,
  "end": 120.46,
  "text": "में भी शामिल हो।"
 },
 {
  "start": 120.46,
  "end": 122.174,
  "text": "हमें हमेशा दिए गए वेग"
 },
 {
  "start": 122.174,
  "end": 123.97,
  "text": "व्यंजक को ही देखना है।"
 },
 {
  "start": 124.08,
  "end": 124.645,
  "text": "अब तक तो दो"
 },
 {
  "start": 124.645,
  "end": 125.62,
  "text": "अभिक्रियाएँ हो गईं।"
 },
 {
  "start": 125.62,
  "end": 127.404,
  "text": "लेकिन तीसरी में, सांद्रता"
 },
 {
  "start": 127.404,
  "end": 129.26,
  "text": "की घात भिन्न में दी गई है।"
 },
 {
  "start": 129.26,
  "end": 130.489,
  "text": "तो क्या इसकी कोटि"
 },
 {
  "start": 130.489,
  "end": 131.79,
  "text": "भी भिन्न में होगी?"
 },
 {
  "start": 131.86,
  "end": 133.44,
  "text": "और इसकी इकाई कैसे निकलेगी?"
 },
 {
  "start": 133.44,
  "end": 135.08,
  "text": "वो Part two में देखते हैं।"
 },
 {
  "start": 135.08,
  "end": 136.13,
  "text": "और अगर पूरे 3 नंबर चाहिए,"
 },
 {
  "start": 137.0,
  "end": 138.53,
  "text": "तो Part two जरूर देखना।"
 }
]