[
  {
    "start": 0.0,
    "end": 1.94,
    "text": "मेरे प्यारे एमपी बोर्ड,"
  },
  {
    "start": 2.1,
    "end": 4.44,
    "text": "कक्षा बारहवीं के बच्चों,"
  },
  {
    "start": 4.44,
    "end": 7.9,
    "text": "ये सवाल 2018 में बोर्ड"
  },
  {
    "start": 7.9,
    "end": 9.58,
    "text": "एग्जाम में पूछा जा चुका है,"
  },
  {
    "start": 9.76,
    "end": 11.34,
    "text": "और इस साल भी आपकी त्रैमासिक"
  },
  {
    "start": 11.34,
    "end": 13.66,
    "text": "परीक्षा में आ सकता है."
  },
  {
    "start": 14.14,
    "end": 15.88,
    "text": "और इन तीनों के डिफरेंस की"
  },
  {
    "start": 15.88,
    "end": 17.7,
    "text": "ये टेबल समझ ली, तो इस"
  },
  {
    "start": 17.7,
    "end": 20.16,
    "text": "सवाल के चार नम्बर पक्के समझो।"
  },
  {
    "start": 20.16,
    "end": 22.26,
    "text": "लेकिन इसमें एक प्रॉब्लम है,"
  },
  {
    "start": 22.28,
    "end": 24.72,
    "text": "ये तीनों प्रतिचुम्बकीय, अनुचुम्बकीय"
  },
  {
    "start": 24.72,
    "end": 26.56,
    "text": "और लौहचुम्बकीय पदार्थों के गुण"
  },
  {
    "start": 26.56,
    "end": 28.52,
    "text": "मिलते-जुलते लगते हैं, इसी"
  },
  {
    "start": 28.52,
    "end": 30.4,
    "text": "लिए बच्चे अक्सर पॉइंट्स उल्टे"
  },
  {
    "start": 30.4,
    "end": 31.88,
    "text": "लिख देते हैं।"
  },
  {
    "start": 31.88,
    "end": 33.18,
    "text": "तो आज हम हर पॉइंट को"
  },
  {
    "start": 33.18,
    "end": 34.6,
    "text": "कंपेयर करके इतनी आसानी से"
  },
  {
    "start": 34.6,
    "end": 36.26,
    "text": "याद करेंगे कि एग्जाम में"
  },
  {
    "start": 36.26,
    "end": 38.9,
    "text": "कभी कन्फ्यूजन नहीं होगा."
  },
  {
    "start": 39.02,
    "end": 40.52,
    "text": "अब एक-एक करके तीनों को"
  },
  {
    "start": 40.52,
    "end": 41.6,
    "text": "समझते हैं."
  },
  {
    "start": 41.66,
    "end": 43.0,
    "text": "सबसे पहले देखते हैं कि"
  },
  {
    "start": 43.0,
    "end": 44.56,
    "text": "चुम्बक के प्रति तीनों पदार्थों"
  },
  {
    "start": 44.56,
    "end": 47.32,
    "text": "का व्यवहार कैसा होता है?"
  },
  {
    "start": 47.32,
    "end": 51.44,
    "text": "प्रतिचुम्बकीय में ये पदार्थ शक्तिशाली"
  },
  {
    "start": 51.44,
    "end": 52.9,
    "text": "चुम्बक द्वारा हल्का सा"
  },
  {
    "start": 52.9,
    "end": 54.58,
    "text": "प्रतिकर्षित होते हैं"
  },
  {
    "start": 54.58,
    "end": 56.9,
    "text": "अनुचुम्बकीय में ये पदार्थ शक्तिशाली"
  },
  {
    "start": 56.9,
    "end": 59.94,
    "text": "चुम्बक द्वारा हल्का सा आकर्षित"
  },
  {
    "start": 59.94,
    "end": 60.76,
    "text": "होते हैं"
  },
  {
    "start": 60.76,
    "end": 62.5,
    "text": "और लौहचुम्बकीय में"
  },
  {
    "start": 62.5,
    "end": 64.08,
    "text": "ये पदार्थ चुम्बक द्वारा"
  },
  {
    "start": 64.08,
    "end": 65.26,
    "text": "बहुत प्रबल रूप से आकर्षित"
  },
  {
    "start": 65.26,
    "end": 66.6,
    "text": "होते हैं"
  },
  {
    "start": 66.6,
    "end": 68.6,
    "text": "और बहुत दुर्बल चुम्बक भी"
  },
  {
    "start": 68.6,
    "end": 70.1,
    "text": "इन्हें आकर्षित कर लेता है"
  },
  {
    "start": 70.1,
    "end": 71.38,
    "text": "सिर्फ इतना दिमाग में बैठा"
  },
  {
    "start": 71.38,
    "end": 77.98,
    "text": "लो प्रतिचुम्बकीय, अनुचुम्बकीय, लौहचुम्बकीय"
  },
  {
    "start": 77.98,
    "end": 79.72,
    "text": "बहुत ज़्यादा आकर्षित होते"
  },
  {
    "start": 79.72,
    "end": 80.48,
    "text": "हैं."
  },
  {
    "start": 80.48,
    "end": 81.8,
    "text": "अब दूसरा पॉइंट।"
  },
  {
    "start": 81.8,
    "end": 83.98,
    "text": "जब इन्हें शक्तिशाली चुम्बक के"
  },
  {
    "start": 83.98,
    "end": 85.58,
    "text": "ध्रुवों के बीच रखते हैं,"
  },
  {
    "start": 85.58,
    "end": 87.18,
    "text": "तो इनकी लंबाई किस दिशा"
  },
  {
    "start": 87.18,
    "end": 88.14,
    "text": "में आती है?"
  },
  {
    "start": 88.14,
    "end": 90.94,
    "text": "प्रतिचुम्बकीय में शक्तिशाली"
  },
  {
    "start": 90.94,
    "end": 92.64,
    "text": "चुम्बक के ध्रुवों के मध्य"
  },
  {
    "start": 92.64,
    "end": 94.58,
    "text": "लटकाने पर इन पदार्थों की"
  },
  {
    "start": 94.58,
    "end": 96.98,
    "text": "लंबाई चुम्बकीय क्षेत्र के"
  },
  {
    "start": 96.98,
    "end": 98.9,
    "text": "लंबवत् हो जाती है."
  },
  {
    "start": 99.14,
    "end": 101.4,
    "text": "अनुचुम्बकीय में शक्तिशाली"
  },
  {
    "start": 101.4,
    "end": 102.66,
    "text": "चुम्बक के ध्रुवों के मध्य"
  },
  {
    "start": 102.66,
    "end": 104.9,
    "text": "लटकाने पर इन पदार्थों की"
  },
  {
    "start": 104.9,
    "end": 107.32,
    "text": "लंबाई चुम्बकीय क्षेत्र के"
  },
  {
    "start": 107.32,
    "end": 109.32,
    "text": "समान्तर हो जाती है."
  },
  {
    "start": 109.32,
    "end": 111.88,
    "text": "और लौहचुम्बकीय में किसी भी"
  },
  {
    "start": 111.88,
    "end": 113.16,
    "text": "चुम्बक के ध्रुवों के मध्य"
  },
  {
    "start": 113.16,
    "end": 115.2,
    "text": "लटकाने पर इन पदार्थों की"
  },
  {
    "start": 115.2,
    "end": 116.62,
    "text": "लंबाई क्षेत्र के समान्तर"
  },
  {
    "start": 116.62,
    "end": 117.58,
    "text": "हो जाती है।"
  },
  {
    "start": 117.58,
    "end": 118.66,
    "text": "तो यहाँ समान्तर और लंबवत्"
  },
  {
    "start": 118.66,
    "end": 120.3,
    "text": "को मिक्स मत करना,"
  },
  {
    "start": 120.3,
    "end": 121.16,
    "text": "यह टेबल में सीधे मार्क्स"
  },
  {
    "start": 121.16,
    "end": 123.38,
    "text": "दिलाने वाला पॉइंट है।"
  },
  {
    "start": 122.9,
    "end": 124.62,
    "text": "दो पॉइंट्स हो गए।"
  },
  {
    "start": 124.62,
    "end": 126.22,
    "text": "अब तीसरा देखते हैं, कम"
  },
  {
    "start": 126.22,
    "end": 127.48,
    "text": "और ज़्यादा तीव्रता वाले क्षेत्र"
  },
  {
    "start": 127.48,
    "end": 128.9,
    "text": "में ये पदार्थ कहाँ जाते"
  },
  {
    "start": 128.9,
    "end": 129.64,
    "text": "हैं।"
  },
  {
    "start": 129.64,
    "end": 131.8,
    "text": "प्रतिचुम्बकीय में ये पदार्थ अधिक"
  },
  {
    "start": 131.8,
    "end": 133.08,
    "text": "तीव्रता वाले क्षेत्र से"
  },
  {
    "start": 133.08,
    "end": 134.5,
    "text": "कम तीव्रता वाले क्षेत्र"
  },
  {
    "start": 134.5,
    "end": 135.58,
    "text": "की ओर जाते हैं।"
  },
  {
    "start": 135.58,
    "end": 137.72,
    "text": "अनुचुम्बकीय में ये पदार्थ"
  },
  {
    "start": 137.72,
    "end": 139.3,
    "text": "कम तीव्रता वाले क्षेत्र"
  },
  {
    "start": 139.3,
    "end": 140.56,
    "text": "से अधिक तीव्रता वाले"
  },
  {
    "start": 140.56,
    "end": 142.12,
    "text": "क्षेत्र की ओर जाते हैं."
  },
  {
    "start": 142.16,
    "end": 143.5,
    "text": "और लौहचुम्बकीय में ये पदार्थ"
  },
  {
    "start": 143.5,
    "end": 145.74,
    "text": "कम तीव्रता वाले क्षेत्र से"
  },
  {
    "start": 145.74,
    "end": 147.32,
    "text": "अधिक तीव्रता वाले क्षेत्र"
  },
  {
    "start": 147.32,
    "end": 148.44,
    "text": "की ओर बहुत तीव्रता से"
  },
  {
    "start": 148.44,
    "end": 149.4,
    "text": "जाते हैं."
  },
  {
    "start": 149.4,
    "end": 151.56,
    "text": "मतलब अनुचुम्बकीय और लौहचुम्बकीय दोनों"
  },
  {
    "start": 151.56,
    "end": 153.62,
    "text": "ही प्रबल चुम्बकीय ओर खिंचते"
  },
  {
    "start": 153.62,
    "end": 155.68,
    "text": "हैं लेकिन लौहचुम्बकीय पदार्थ"
  },
  {
    "start": 155.68,
    "end": 157.32,
    "text": "ज़्यादा तेजी से खिंचते हैं"
  },
  {
    "start": 157.32,
    "end": 158.98,
    "text": "तो बच्चों पहले तीन पॉइंट"
  },
  {
    "start": 158.98,
    "end": 160.1,
    "text": "अब क्लियर हैं।"
  },
  {
    "start": 160.1,
    "end": 161.42,
    "text": "लेकिन अभी भी तीन और"
  },
  {
    "start": 161.42,
    "end": 162.98,
    "text": "ज़रूरी पॉइंट बाकी हैं।"
  },
  {
    "start": 162.98,
    "end": 164.3,
    "text": "और वो हम देखेंगे नेक्स्ट"
  },
  {
    "start": 164.3,
    "end": 164.9,
    "text": "पार्ट में।"
  },
  {
    "start": 164.86,
    "end": 166.14,
    "text": "इसलिए पार्ट टू बिल्कुल"
  },
  {
    "start": 166.14,
    "end": 166.98,
    "text": "भी मिस मत करना."
  }
]