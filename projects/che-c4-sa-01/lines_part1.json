[
 {
  "start": 0.0,
  "end": 1.64,
  "text": "MP Board कक्षा"
 },
 {
  "start": 1.64,
  "end": 2.44,
  "text": "बारहवीं के बच्चों,"
 },
 {
  "start": 2.44,
  "end": 5.12,
  "text": "ये सवाल 2024 में board"
 },
 {
  "start": 5.12,
  "end": 6.4,
  "text": "exam में पूछा जा चुका है,"
 },
 {
  "start": 6.4,
  "end": 7.64,
  "text": "और इस साल भी आपकी"
 },
 {
  "start": 7.64,
  "end": 9.16,
  "text": "परीक्षा में आ सकता है।"
 },
 {
  "start": 9.16,
  "end": 10.72,
  "text": "तो आज इसे समझेंगे,"
 },
 {
  "start": 10.72,
  "end": 12.64,
  "text": "कि परीक्षा में 3"
 },
 {
  "start": 12.64,
  "end": 13.76,
  "text": "नंबर पक्के हो जाएंगे।"
 },
 {
  "start": 13.76,
  "end": 15.86,
  "text": "चलो, सबसे पहले समझते हैं,"
 },
 {
  "start": 15.86,
  "end": 16.94,
  "text": "कि उत्पादकता आखिर"
 },
 {
  "start": 16.94,
  "end": 18.26,
  "text": "होती क्या है।"
 },
 {
  "start": 18.26,
  "end": 19.609,
  "text": "लैन्थेनाइड श्रेणी"
 },
 {
  "start": 19.609,
  "end": 20.72,
  "text": "में, जैसे-जैसे"
 },
 {
  "start": 20.72,
  "end": 23.4,
  "text": "परमाणु क्रमांक बढ़ता जाता है,"
 },
 {
  "start": 23.4,
  "end": 24.4,
  "text": "वैसे-वैसे उनके परमाणुओं"
 },
 {
  "start": 24.4,
  "end": 26.36,
  "text": "और आयनों के आकार में,"
 },
 {
  "start": 26.36,
  "end": 28.44,
  "text": "लगातार कमी होती जाती है।"
 },
 {
  "start": 28.44,
  "end": 29.64,
  "text": "परमाणुओं और आयनों के"
 },
 {
  "start": 29.64,
  "end": 30.78,
  "text": "आकार में होने वाली,"
 },
 {
  "start": 30.78,
  "end": 33.54,
  "text": "इसी लगातार कमी को,"
 },
 {
  "start": 33.54,
  "end": 34.34,
  "text": "लैन्थेनॉइड संकुचन कहते हैं।"
 },
 {
  "start": 34.34,
  "end": 35.14,
  "text": "अब ध्यान देना,"
 },
 {
  "start": 35.14,
  "end": 36.2,
  "text": "आकार कम होने की ये"
 },
 {
  "start": 36.2,
  "end": 37.5,
  "text": "बात तो समझ आ गई,"
 },
 {
  "start": 37.5,
  "end": 39.4,
  "text": "लेकिन आखिर ऐसा होता क्यों है?"
 },
 {
  "start": 39.4,
  "end": 41.2,
  "text": "और यहीं इसका सबसे"
 },
 {
  "start": 41.2,
  "end": 43.58,
  "text": "मुख्य कारण आता है।"
 },
 {
  "start": 43.58,
  "end": 44.4,
  "text": "लैन्थेनाइड तत्वों में जब"
 },
 {
  "start": 44.4,
  "end": 46.3,
  "text": "नया इलेक्ट्रान जुड़ता है,"
 },
 {
  "start": 46.3,
  "end": 47.46,
  "text": "तो वह बाहरी कोश"
 },
 {
  "start": 47.46,
  "end": 48.54,
  "text": "में जाने के बजाय,"
 },
 {
  "start": 48.54,
  "end": 50.22,
  "text": "n minus two f उपकोश"
 },
 {
  "start": 50.22,
  "end": 51.52,
  "text": "में प्रवेश करता है।"
 },
 {
  "start": 51.52,
  "end": 53.147,
  "text": "अब यहाँ एक important बात है,"
 },
 {
  "start": 53.147,
  "end": 53.96,
  "text": "f-electrons का"
 },
 {
  "start": 53.96,
  "end": 54.88,
  "text": "परिरक्षण प्रभाव,"
 },
 {
  "start": 54.88,
  "end": 56.658,
  "text": "बहुत कम प्रभावी होता है।"
 },
 {
  "start": 56.658,
  "end": 58.14,
  "text": "इस वजह से, जैसे-जैसे"
 },
 {
  "start": 58.14,
  "end": 59.52,
  "text": "परमाणु क्रमांक बढ़ता है,"
 },
 {
  "start": 59.52,
  "end": 60.32,
  "text": "नाभिक का धनावेश"
 },
 {
  "start": 60.32,
  "end": 61.34,
  "text": "भी बढ़ता जाता है,"
 },
 {
  "start": 61.34,
  "end": 63.32,
  "text": "लेकिन परिरक्षण प्रभाव, उस"
 },
 {
  "start": 63.32,
  "end": 65.98,
  "text": "बढ़े हुए नाभिकीय आवेश को,"
 },
 {
  "start": 65.98,
  "end": 67.1,
  "text": "प्रभावी रूप से"
 },
 {
  "start": 67.1,
  "end": 69.12,
  "text": "संतुलित नहीं कर पाता।"
 },
 {
  "start": 69.12,
  "end": 71.094,
  "text": "अब यहाँ एक बात ध्यान रखना,"
 },
 {
  "start": 71.094,
  "end": 72.613,
  "text": "जैसे-जैसे यह process"
 },
 {
  "start": 72.613,
  "end": 73.6,
  "text": "आगे बढ़ता है,"
 },
 {
  "start": 73.6,
  "end": 74.88,
  "text": "नाभिक और इलेक्ट्रॉन के बीच,"
 },
 {
  "start": 74.88,
  "end": 77.24,
  "text": "आकर्षण बल बढ़ता जाता है।"
 },
 {
  "start": 77.24,
  "end": 80.36,
  "text": "परमाणु क्रमांक बढ़ने पर,"
 },
 {
  "start": 80.36,
  "end": 82.44,
  "text": "नाभिकीय आकर्षण बढ़ता है,"
 },
 {
  "start": 82.44,
  "end": 84.88,
  "text": "और परमाणु तथा आयन का"
 },
 {
  "start": 84.88,
  "end": 87.8,
  "text": "आकार, कम होता जाता है।"
 },
 {
  "start": 87.8,
  "end": 90.22,
  "text": "बस, इसी वजह से लैन्थेनाइड"
 },
 {
  "start": 90.22,
  "end": 91.82,
  "text": "श्रेणी में आगे बढ़ने पर,"
 },
 {
  "start": 91.82,
  "end": 94.56,
  "text": "आकार लगातार घटता जाता है।"
 },
 {
  "start": 94.56,
  "end": 96.76,
  "text": "और इस लगातार कमी को ही,"
 },
 {
  "start": 96.76,
  "end": 98.72,
  "text": "हम लैन्थेनॉइड संकुचन कहते हैं।"
 },
 {
  "start": 98.72,
  "end": 100.6,
  "text": "तो बच्चों, अभी तक हमने समझा"
 },
 {
  "start": 100.6,
  "end": 102.26,
  "text": "कि लैन्थेनॉइड संकुचन क्या है,"
 },
 {
  "start": 102.26,
  "end": 103.52,
  "text": "और इसके पीछे मुख्य"
 },
 {
  "start": 103.52,
  "end": 104.48,
  "text": "कारण क्या है।"
 },
 {
  "start": 104.48,
  "end": 107.02,
  "text": "लेकिन सवाल का दूसरा और बहुत"
 },
 {
  "start": 107.02,
  "end": 108.22,
  "text": "important हिस्सा बाकी है,"
 },
 {
  "start": 108.22,
  "end": 109.02,
  "text": "लैन्थेनॉइड संकुचन के"
 },
 {
  "start": 109.02,
  "end": 110.18,
  "text": "प्रभाव क्या होते हैं?"
 },
 {
  "start": 110.18,
  "end": 112.111,
  "text": "इसके दो प्रमुख प्रभाव हैं,"
 },
 {
  "start": 112.111,
  "end": 113.82,
  "text": "जिन्हें exam में points"
 },
 {
  "start": 113.82,
  "end": 115.66,
  "text": "के साथ लिखना जरूरी है।"
 },
 {
  "start": 115.66,
  "end": 117.207,
  "text": "तो अब Part two में,"
 },
 {
  "start": 117.207,
  "end": 119.08,
  "text": "इन्हीं दोनों effects को"
 },
 {
  "start": 119.08,
  "end": 120.11,
  "text": "एक-एक करके समझते हैं।"
 }
]