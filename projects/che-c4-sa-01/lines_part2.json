[
 {
  "start": 0.0,
  "end": 1.715,
  "text": "MP Board कक्षा"
 },
 {
  "start": 1.715,
  "end": 3.92,
  "text": "बारहवीं के बच्चों,"
 },
 {
  "start": 3.92,
  "end": 5.3,
  "text": "Part one में हमने समझा था,"
 },
 {
  "start": 5.3,
  "end": 7.02,
  "text": "कि लैन्थेनाइड श्रेणी में"
 },
 {
  "start": 7.02,
  "end": 9.14,
  "text": "परमाणु क्रमांक बढ़ने के साथ,"
 },
 {
  "start": 9.14,
  "end": 11.28,
  "text": "परमाणुओं और आयनों के आकार"
 },
 {
  "start": 11.28,
  "end": 13.42,
  "text": "में, लगातार कमी होती है,"
 },
 {
  "start": 13.42,
  "end": 15.56,
  "text": "और इस घटना को, लैन्थेनॉइड"
 },
 {
  "start": 15.56,
  "end": 16.98,
  "text": "संकुचन कहते हैं।"
 },
 {
  "start": 16.98,
  "end": 18.22,
  "text": "अब आते हैं इस question के"
 },
 {
  "start": 18.22,
  "end": 19.9,
  "text": "दूसरे और important part पर,"
 },
 {
  "start": 19.9,
  "end": 22.16,
  "text": "लैन्थेनॉइड संकुचन के प्रभाव।"
 },
 {
  "start": 22.16,
  "end": 24.14,
  "text": "इसके दो प्रमुख प्रभाव हैं।"
 },
 {
  "start": 24.14,
  "end": 25.022,
  "text": "तो चलो, दोनों को"
 },
 {
  "start": 25.022,
  "end": 26.18,
  "text": "एक-एक करके समझते हैं।"
 },
 {
  "start": 26.18,
  "end": 28.12,
  "text": "पहला प्रभाव, लैन्थेनाइडों"
 },
 {
  "start": 28.12,
  "end": 30.0,
  "text": "के गुणों में परिवर्तन।"
 },
 {
  "start": 30.0,
  "end": 31.96,
  "text": "इस प्रभाव में, लैन्थेनॉइड"
 },
 {
  "start": 31.96,
  "end": 33.22,
  "text": "संकुचन के कारण,"
 },
 {
  "start": 33.22,
  "end": 35.22,
  "text": "एक लैन्थेनाइड से दूसरे"
 },
 {
  "start": 35.22,
  "end": 36.32,
  "text": "लैन्थेनाइड के बीच,"
 },
 {
  "start": 36.32,
  "end": 37.88,
  "text": "रासायनिक गुणों में बहुत"
 },
 {
  "start": 37.88,
  "end": 39.72,
  "text": "कम परिवर्तन होता है।"
 },
 {
  "start": 39.72,
  "end": 41.0,
  "text": "इसका मतलब है कि, इन"
 },
 {
  "start": 41.0,
  "end": 42.54,
  "text": "तत्वों के रासायनिक गुण,"
 },
 {
  "start": 42.54,
  "end": 44.38,
  "text": "काफी समान होते हैं।"
 },
 {
  "start": 44.38,
  "end": 45.54,
  "text": "और जब तत्वों के"
 },
 {
  "start": 45.54,
  "end": 47.02,
  "text": "गुण इतने समान हों,"
 },
 {
  "start": 47.02,
  "end": 48.06,
  "text": "तो उन्हें एक-दूसरे से"
 },
 {
  "start": 48.06,
  "end": 49.824,
  "text": "अलग करना आसान नहीं होता।"
 },
 {
  "start": 49.824,
  "end": 51.22,
  "text": "इसीलिए लैन्थेनाइडों"
 },
 {
  "start": 51.22,
  "end": 52.86,
  "text": "को, शुद्ध अवस्था"
 },
 {
  "start": 52.86,
  "end": 53.76,
  "text": "में प्राप्त करना"
 },
 {
  "start": 53.76,
  "end": 55.16,
  "text": "बहुत कठिन होता है।"
 },
 {
  "start": 55.16,
  "end": 56.82,
  "text": "तो पहले प्रभाव में बस"
 },
 {
  "start": 56.82,
  "end": 58.52,
  "text": "इतना दिमाग में रखो कि"
 },
 {
  "start": 58.52,
  "end": 59.32,
  "text": "रासायनिक गुणों में"
 },
 {
  "start": 59.32,
  "end": 60.96,
  "text": "कम अंतर होता है,"
 },
 {
  "start": 60.96,
  "end": 61.76,
  "text": "इसलिए इन्हें अलग"
 },
 {
  "start": 61.76,
  "end": 62.88,
  "text": "करना मुश्किल होता है।"
 },
 {
  "start": 62.88,
  "end": 63.96,
  "text": "चलो, अब दूसरे"
 },
 {
  "start": 63.96,
  "end": 65.16,
  "text": "प्रभाव पर आते हैं,"
 },
 {
  "start": 65.16,
  "end": 66.9,
  "text": "अन्य तत्वों के गुणों पर"
 },
 {
  "start": 66.9,
  "end": 68.76,
  "text": "इसका क्या असर पड़ता है"
 },
 {
  "start": 68.76,
  "end": 70.18,
  "text": "और इसे भी पहले की तरह"
 },
 {
  "start": 70.18,
  "end": 72.14,
  "text": "आसानी से समझते हैं।"
 },
 {
  "start": 72.14,
  "end": 74.02,
  "text": "तो इसमें, लैन्थेनॉइड"
 },
 {
  "start": 74.02,
  "end": 75.46,
  "text": "संकुचन का प्रभाव,"
 },
 {
  "start": 75.46,
  "end": 77.1,
  "text": "केवल लैन्थेनाइड तत्वों"
 },
 {
  "start": 77.1,
  "end": 78.8,
  "text": "तक ही सीमित नहीं रहता।"
 },
 {
  "start": 78.8,
  "end": 80.18,
  "text": "इसका प्रभाव,"
 },
 {
  "start": 80.18,
  "end": 81.74,
  "text": "लैन्थेनाइडों से पहले"
 },
 {
  "start": 81.74,
  "end": 84.06,
  "text": "और बाद में आने वाले तत्वों के,"
 },
 {
  "start": 84.06,
  "end": 85.32,
  "text": "सापेक्षिक गुणों"
 },
 {
  "start": 85.32,
  "end": 86.36,
  "text": "पर भी पड़ता है।"
 },
 {
  "start": 86.36,
  "end": 90.26,
  "text": "इसके उदाहरण है, Z r और H f।"
 },
 {
  "start": 90.26,
  "end": 91.32,
  "text": "Z r और H f के गुणों में,"
 },
 {
  "start": 91.32,
  "end": 94.0,
  "text": "काफी समानता पाई जाती है।"
 },
 {
  "start": 94.0,
  "end": 96.44,
  "text": "इस समानता के पीछे,"
 },
 {
  "start": 96.44,
  "end": 98.06,
  "text": "लैन्थेनॉइड संकुचन का"
 },
 {
  "start": 98.06,
  "end": 99.22,
  "text": "important role होता है।"
 },
 {
  "start": 99.22,
  "end": 100.58,
  "text": "बस, अब ये concept"
 },
 {
  "start": 100.58,
  "end": 101.78,
  "text": "भी पूरा clear है।"
 },
 {
  "start": 101.78,
  "end": 103.32,
  "text": "इसे exam में सही"
 },
 {
  "start": 103.32,
  "end": 104.42,
  "text": "तरीके से लिख दिया,"
 },
 {
  "start": 104.42,
  "end": 106.1,
  "text": "तो तीन नंबर पक्के,"
 },
 {
  "start": 106.1,
  "end": 107.92,
  "text": "और exam में इसे कैसे लिखना है,"
 },
 {
  "start": 107.92,
  "end": 109.86,
  "text": "वो आपकी screen पर दिए"
 },
 {
  "start": 109.86,
  "end": 110.78,
  "text": "Notes button पर मिल जाएगा।"
 },
 {
  "start": 110.78,
  "end": 112.16,
  "text": "बस ऐसे ही एक-एक"
 },
 {
  "start": 112.16,
  "end": 113.06,
  "text": "topic पूरा करते जाओ,"
 },
 {
  "start": 113.06,
  "end": 114.66,
  "text": "और 90 परसेंट की तैयारी"
 },
 {
  "start": 114.66,
  "end": 115.83,
  "text": "के करीब बढ़ते जाओ।"
 }
]