[
 {
  "start": 0.0,
  "end": 1.5,
  "text": "MP Board कक्षा"
 },
 {
  "start": 1.5,
  "end": 2.34,
  "text": "बारहवीं के बच्चों,"
 },
 {
  "start": 2.34,
  "end": 6.44,
  "text": "ये सवाल 2019 और 2023 में board"
 },
 {
  "start": 6.44,
  "end": 7.82,
  "text": "exam में पूछा जा चुका है,"
 },
 {
  "start": 7.82,
  "end": 9.9,
  "text": "और इस साल भी आपकी परीक्षा"
 },
 {
  "start": 9.9,
  "end": 11.34,
  "text": "में आने के chances हैं।"
 },
 {
  "start": 11.34,
  "end": 12.72,
  "text": "तो बच्चों, इस सवाल"
 },
 {
  "start": 12.72,
  "end": 13.86,
  "text": "में हम समझेंगे,"
 },
 {
  "start": 13.86,
  "end": 15.58,
  "text": "कि genetic code क्या होता है,"
 },
 {
  "start": 15.58,
  "end": 16.48,
  "text": "और इसकी चार"
 },
 {
  "start": 16.48,
  "end": 17.8,
  "text": "विशेषताएँ क्या हैं,"
 },
 {
  "start": 17.8,
  "end": 19.58,
  "text": "और इसे अच्छे से समझ लिया,"
 },
 {
  "start": 19.58,
  "end": 22.22,
  "text": "तो exam में 3 नंबर पक्के समझो।"
 },
 {
  "start": 22.22,
  "end": 23.12,
  "text": "चलिए शुरू करते हैं,"
 },
 {
  "start": 23.12,
  "end": 24.538,
  "text": "mRNA पर उपस्थित"
 },
 {
  "start": 24.538,
  "end": 26.24,
  "text": "तीन-तीन नाइट्रोजनी"
 },
 {
  "start": 26.24,
  "end": 27.08,
  "text": "क्षारों के क्रम को,"
 },
 {
  "start": 27.08,
  "end": 28.78,
  "text": "प्रकूट यानी कोडॉन,"
 },
 {
  "start": 28.78,
  "end": 30.44,
  "text": "या आनुवंशिक कूट यानी"
 },
 {
  "start": 30.44,
  "end": 32.12,
  "text": "जेनेटिक कोड कहते हैं।"
 },
 {
  "start": 32.12,
  "end": 34.36,
  "text": "यही प्रकूट, किसी विशेष अमीनो"
 },
 {
  "start": 34.36,
  "end": 38.1,
  "text": "अम्ल का कूट लेखन करता है,"
 },
 {
  "start": 38.1,
  "end": 38.9,
  "text": "तथा प्रोटीन संश्लेषण के दौरान,"
 },
 {
  "start": 38.9,
  "end": 40.48,
  "text": "अमीनो अम्ल के अनुक्रम"
 },
 {
  "start": 40.48,
  "end": 41.98,
  "text": "को निर्धारित करता है।"
 },
 {
  "start": 41.98,
  "end": 43.98,
  "text": "इसका मतलब, mRNA पर"
 },
 {
  "start": 43.98,
  "end": 45.98,
  "text": "तीन-तीन नाइट्रोजनी"
 },
 {
  "start": 45.98,
  "end": 46.86,
  "text": "क्षार मिलकर एक"
 },
 {
  "start": 46.86,
  "end": 48.16,
  "text": "प्रकूट बनाते हैं,"
 },
 {
  "start": 48.16,
  "end": 50.2,
  "text": "और ये प्रकूट यह तय करते"
 },
 {
  "start": 50.2,
  "end": 51.44,
  "text": "हैं कि प्रोटीन बनाते"
 },
 {
  "start": 51.44,
  "end": 52.98,
  "text": "समय कौन-सा अमीनो"
 },
 {
  "start": 52.98,
  "end": 54.331,
  "text": "अम्ल जोड़ा जाएगा।"
 },
 {
  "start": 54.331,
  "end": 55.8,
  "text": "समझ में आया बच्चों,"
 },
 {
  "start": 55.8,
  "end": 56.6,
  "text": "इसे परीक्षा में"
 },
 {
  "start": 56.6,
  "end": 57.74,
  "text": "ऐसे ही लिखना है।"
 },
 {
  "start": 57.74,
  "end": 58.96,
  "text": "तो बच्चों, अब आते हैं"
 },
 {
  "start": 58.96,
  "end": 61.36,
  "text": "इसकी पहली विशेषता पर।"
 },
 {
  "start": 61.36,
  "end": 62.16,
  "text": "आनुवंशिक कूट की पहली"
 },
 {
  "start": 62.16,
  "end": 64.3,
  "text": "विशेषता है, त्रिक प्रकृति।"
 },
 {
  "start": 64.3,
  "end": 65.84,
  "text": "इसका मतलब है, कि"
 },
 {
  "start": 65.84,
  "end": 67.069,
  "text": "प्रत्येक प्रकूट,"
 },
 {
  "start": 67.069,
  "end": 68.76,
  "text": "तीन नाइट्रोजनी क्षारों"
 },
 {
  "start": 68.76,
  "end": 70.687,
  "text": "से मिलकर बना होता है।"
 },
 {
  "start": 70.687,
  "end": 71.972,
  "text": "जैसे screen पर"
 },
 {
  "start": 71.972,
  "end": 73.38,
  "text": "आप A U G, U U U,"
 },
 {
  "start": 73.38,
  "end": 74.18,
  "text": "और G G C देख रहे हो।"
 },
 {
  "start": 74.18,
  "end": 76.38,
  "text": "ये तीनों, तीन-तीन क्षारों"
 },
 {
  "start": 76.38,
  "end": 77.58,
  "text": "से बने प्रकूट हैं।"
 },
 {
  "start": 77.58,
  "end": 78.82,
  "text": "तो गाँठ बाँध लो,"
 },
 {
  "start": 78.82,
  "end": 81.54,
  "text": "एक प्रकूट में हमेशा तीन"
 },
 {
  "start": 81.54,
  "end": 82.34,
  "text": "नाइट्रोजनी क्षार होते हैं।"
 },
 {
  "start": 82.34,
  "end": 83.6,
  "text": "अब हम दूसरी विशेषता"
 },
 {
  "start": 83.6,
  "end": 85.04,
  "text": "को समझते हैं,"
 },
 {
  "start": 85.04,
  "end": 85.86,
  "text": "असंदिग्ध व विशिष्ट का मतलब"
 },
 {
  "start": 85.86,
  "end": 88.2,
  "text": "है, कि प्रत्येक प्रकूट,"
 },
 {
  "start": 88.2,
  "end": 89.12,
  "text": "केवल एक ही अमीनो अम्ल"
 },
 {
  "start": 89.12,
  "end": 90.44,
  "text": "के लिए विशिष्ट होता है।"
 },
 {
  "start": 90.44,
  "end": 92.888,
  "text": "उदाहरण के लिए, U U U कोडॉन,"
 },
 {
  "start": 92.888,
  "end": 94.52,
  "text": "फिनाइलएलैनिन अमीनो"
 },
 {
  "start": 94.52,
  "end": 95.6,
  "text": "अम्ल को कोड करता है।"
 },
 {
  "start": 95.6,
  "end": 97.3,
  "text": "तो दूसरी विशेषता को भी अच्छे"
 },
 {
  "start": 97.3,
  "end": 99.58,
  "text": "से याद कर लो, कि एक कोडॉन,"
 },
 {
  "start": 99.58,
  "end": 101.28,
  "text": "एक निश्चित अमीनो अम्ल"
 },
 {
  "start": 101.28,
  "end": 102.9,
  "text": "का कूट लेखन करता है।"
 },
 {
  "start": 102.9,
  "end": 105.22,
  "text": "तो बच्चों, अभी तक 2"
 },
 {
  "start": 105.22,
  "end": 106.02,
  "text": "विशेषताएँ clear हो गईं।"
 },
 {
  "start": 106.02,
  "end": 107.58,
  "text": "अब तीसरी और चौथी"
 },
 {
  "start": 107.58,
  "end": 108.58,
  "text": "विशेषता क्या है,"
 },
 {
  "start": 108.58,
  "end": 110.55,
  "text": "ये Part two में देखेंगे।"
 }
]