[
 {
  "start": 0.0,
  "end": 1.24,
  "text": "बच्चों, part one"
 },
 {
  "start": 1.24,
  "end": 2.52,
  "text": "में हमने समझा था,"
 },
 {
  "start": 2.52,
  "end": 4.5,
  "text": "कि आनुवंशिक कूट क्या होता है,"
 },
 {
  "start": 4.5,
  "end": 6.88,
  "text": "और इसकी 2 विशेषताएँ क्या हैं।"
 },
 {
  "start": 6.88,
  "end": 9.38,
  "text": "अब इस part में हम,"
 },
 {
  "start": 9.38,
  "end": 10.28,
  "text": "आनुवंशिक कूट की तीसरी"
 },
 {
  "start": 10.28,
  "end": 12.16,
  "text": "और चौथी विशेषता समझेंगे,"
 },
 {
  "start": 12.16,
  "end": 14.38,
  "text": "और देखेंगे कि ये अलग कैसे है।"
 },
 {
  "start": 14.38,
  "end": 15.9,
  "text": "चलो तीसरी विशेषता समझते"
 },
 {
  "start": 15.9,
  "end": 17.38,
  "text": "हैं, तो इसे ध्यान से समझो।"
 },
 {
  "start": 17.38,
  "end": 18.8,
  "text": "एक ही अमीनो अम्ल के लिए,"
 },
 {
  "start": 18.8,
  "end": 21.18,
  "text": "एक से अधिक प्रकूट हो सकते हैं।"
 },
 {
  "start": 21.18,
  "end": 24.6,
  "text": "उदाहरण के लिए, ल्यूसीन के लिए,"
 },
 {
  "start": 24.6,
  "end": 25.58,
  "text": "6 अलग-अलग प्रकूट होते हैं।"
 },
 {
  "start": 25.58,
  "end": 27.52,
  "text": "यानी, एक अमीनो अम्ल"
 },
 {
  "start": 27.52,
  "end": 30.36,
  "text": "को कोड करने के लिए,"
 },
 {
  "start": 30.36,
  "end": 31.7,
  "text": "कई अलग-अलग प्रकूट हो सकते हैं।"
 },
 {
  "start": 31.7,
  "end": 32.96,
  "text": "यही इसकी डीजेनरेट"
 },
 {
  "start": 32.96,
  "end": 34.58,
  "text": "प्रकृति कहलाती है।"
 },
 {
  "start": 34.58,
  "end": 35.72,
  "text": "और चौथी विशेषता"
 },
 {
  "start": 35.72,
  "end": 37.34,
  "text": "है, सार्वभौमिकता।"
 },
 {
  "start": 37.34,
  "end": 39.4,
  "text": "इसका मतलब है, कि"
 },
 {
  "start": 39.4,
  "end": 40.56,
  "text": "लगभग सभी जीवों में,"
 },
 {
  "start": 40.56,
  "end": 42.56,
  "text": "समान प्रकूट समान अमीनो"
 },
 {
  "start": 42.56,
  "end": 44.74,
  "text": "अम्ल का कूट लेखन करते हैं।"
 },
 {
  "start": 44.74,
  "end": 48.02,
  "text": "उदाहरण के लिए, A U G कोडॉन,"
 },
 {
  "start": 48.02,
  "end": 49.6,
  "text": "लगभग सभी जीवों में मेथियोनीन"
 },
 {
  "start": 49.6,
  "end": 50.94,
  "text": "अमीनो अम्ल का"
 },
 {
  "start": 50.94,
  "end": 52.62,
  "text": "कूट लेखन करता है।"
 },
 {
  "start": 52.62,
  "end": 54.52,
  "text": "यानी बच्चों, अगर किसी"
 },
 {
  "start": 54.52,
  "end": 56.54,
  "text": "mRNA में A U G प्रकूट है,"
 },
 {
  "start": 56.54,
  "end": 57.96,
  "text": "तो उसका कूट लेखन"
 },
 {
  "start": 57.96,
  "end": 59.52,
  "text": "मेथियोनीन ही होगा।"
 },
 {
  "start": 59.52,
  "end": 61.86,
  "text": "इसी कारण, आनुवंशिक कूट को"
 },
 {
  "start": 61.86,
  "end": 63.632,
  "text": "सार्वभौमिक कहा जाता है।"
 },
 {
  "start": 63.632,
  "end": 64.788,
  "text": "बच्चों, अब तक 4"
 },
 {
  "start": 64.788,
  "end": 66.56,
  "text": "विशेषताएँ तो clear हैं।"
 },
 {
  "start": 66.56,
  "end": 68.56,
  "text": "चलो, एक बार चारों को जल्दी"
 },
 {
  "start": 68.56,
  "end": 70.2,
  "text": "से revise कर लेते हैं।"
 },
 {
  "start": 70.2,
  "end": 71.92,
  "text": "पहली है त्रिक प्रकृति,"
 },
 {
  "start": 71.92,
  "end": 74.48,
  "text": "यानी एक प्रकूट तीन नाइट्रोजनी"
 },
 {
  "start": 74.48,
  "end": 75.5,
  "text": "क्षारों से बना होता है।"
 },
 {
  "start": 75.5,
  "end": 77.2,
  "text": "दूसरी है असंदिग्ध,"
 },
 {
  "start": 77.2,
  "end": 79.28,
  "text": "यानी प्रत्येक प्रकूट,"
 },
 {
  "start": 79.28,
  "end": 80.24,
  "text": "केवल एक अमीनो अम्ल"
 },
 {
  "start": 80.24,
  "end": 81.6,
  "text": "का कूट लेखन करता है।"
 },
 {
  "start": 81.6,
  "end": 84.26,
  "text": "तीसरी है अपह्रासिता, यानी"
 },
 {
  "start": 84.26,
  "end": 85.98,
  "text": "एक अमीनो अम्ल के लिए,"
 },
 {
  "start": 85.98,
  "end": 88.84,
  "text": "एक से अधिक प्रकूट हो सकते हैं।"
 },
 {
  "start": 88.84,
  "end": 90.92,
  "text": "और चौथी सार्वभौमिक है,"
 },
 {
  "start": 90.92,
  "end": 92.9,
  "text": "यानी लगभग सभी जीवों में,"
 },
 {
  "start": 92.9,
  "end": 94.94,
  "text": "समान प्रकूट समान अमीनो"
 },
 {
  "start": 94.94,
  "end": 96.54,
  "text": "अम्ल का कूट लेखन करते हैं।"
 },
 {
  "start": 96.54,
  "end": 99.06,
  "text": "तो बच्चों, 3 नंबर का ये"
 },
 {
  "start": 99.06,
  "end": 100.68,
  "text": "answer भी पूरा तैयार है।"
 },
 {
  "start": 100.68,
  "end": 102.54,
  "text": "अब परीक्षा में इसका exact"
 },
 {
  "start": 102.54,
  "end": 103.52,
  "text": "answer कैसे लिखना है,"
 },
 {
  "start": 103.52,
  "end": 104.92,
  "text": "वो Notes में मिल जाएगा।"
 },
 {
  "start": 104.92,
  "end": 106.6,
  "text": "बस, ऐसे ही एक-एक"
 },
 {
  "start": 106.6,
  "end": 108.125,
  "text": "topic पक्का करते जाओ,"
 },
 {
  "start": 108.125,
  "end": 109.1,
  "text": "और exam की तैयारी"
 },
 {
  "start": 109.1,
  "end": 109.9,
  "text": "मजबूत करते जाओ।"
 }
]