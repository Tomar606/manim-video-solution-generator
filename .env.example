# --- AI educational video pipeline ---
# Copy to .env and fill in. bin/bootstrap.sh does this for you.

# =============================================================================
# Claude — script writing, Manim code generation, render-repair, QC review
# =============================================================================
# Two ways to reach Claude. Pick one:
#
#   1. Claude Code CLI (default) — billed to your Claude subscription.
#      Install once:  npm install -g @anthropic-ai/claude-code && claude
#      Leave ANTHROPIC_API_KEY unset and there is nothing to configure here.
#
#   2. API key — pay per token, but works unattended (CI, servers, Docker).
#      Set ANTHROPIC_API_KEY below.
#
# LLM_BACKEND picks between them: auto (default) | cli | api
# LLM_BACKEND=auto
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional overrides
# CLAUDE_MODEL=claude-opus-5
# CLAUDE_EFFORT=high              # low | medium | high | xhigh | max
# CLAUDE_CLI_TIMEOUT=900          # seconds per generation call

# =============================================================================
# OpenAI — script writing
# =============================================================================
# The pipeline is per-stage about models: SCRIPT_LLM picks who writes the
# narration, while Manim code generation and QC stay on Claude. Set this to
# openai once the key is in place.
# OPENAI_API_KEY=sk-...
# SCRIPT_LLM=openai               # auto (default) | openai | claude
# OPENAI_MODEL=gpt-4.1            # whichever model you've settled on
# OPENAI_BASE_URL=                # only if you front OpenAI with a gateway

# =============================================================================
# ElevenLabs — multi-voice narration (required to render with sound)
# =============================================================================
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Fallback voice id used when a speaker's voice can't be resolved
# ELEVENLABS_DEFAULT_VOICE=
# ELEVENLABS_MODEL=eleven_multilingual_v2
# TTS_GAP_SECONDS=0.4

# =============================================================================
# HeyGen — presenter clips (optional)
# =============================================================================
# Without a key the pipeline uses the manual workflow: `video avatar --briefs`
# writes what to generate, and you drop the clips into the project's avatar/
# folder. Setting these switches the same stage over to the API.
# HEYGEN_API_KEY=
# HEYGEN_AVATAR_ID=
# HEYGEN_VOICE_ID=
# HEYGEN_API_BASE=https://api.heygen.com

# =============================================================================
# Legacy pipeline (main.py) only
# =============================================================================
# OPENAI_API_KEY=your_openai_api_key_here
