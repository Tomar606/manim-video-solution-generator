# Copy to .env and fill in. .env is gitignored: never commit it.

# Whisper word timings for captions (tools/kit_captions.py). Without credits, captions fall back to
# tools/pause_align.py, which needs no key.
OPENAI_API_KEY=

# The question sheets (tools/sheet_fetch.py): the part of each sheet's URL after /d/. The sheets are
# readable by link, so these IDs are as good as the sheets themselves: keep them out of the repo.
SHEET_ARTS=
SHEET_SCIENCE=

# Where tools/deliver.py puts finished reels (default: your Desktop). On Windows with OneDrive, e.g.
# DELIVER_ROOT=C:\Users\<you>\OneDrive\Desktop
DELIVER_ROOT=

# The answer-page check reads pages with Claude. The default uses the Claude Code CLI (no key needed);
# set these only to use the API instead.
# LLM_BACKEND=auto
# ANTHROPIC_API_KEY=
