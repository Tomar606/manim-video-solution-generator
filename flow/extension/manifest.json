{
  "manifest_version": 3,
  "name": "PYQ Flow Bridge",
  "version": "0.2.0",
  "description": "Lets the PYQ pipeline drive Google Flow from a background tab. The tab needs no focus and no visible window.",
  "permissions": ["downloads", "storage", "notifications", "scripting", "debugger", "tabs", "alarms"],
  "host_permissions": [
    "https://labs.google/*",
    "https://flow.google/*",
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://labs.google/*", "https://flow.google/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_title": "PYQ Flow Bridge — click to show the status panel" }
}
