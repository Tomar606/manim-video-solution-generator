# Standalone answer-card renders. Cards written into a project's assets/ ARE
# tracked (they're an input to script.md's answer_image:) — this is only the
# scratch output dir used when `video answer` runs without a project.
out/

# Environment
.env
venv/
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Build output. Everything under projects/ is regenerated from script.md, so
# only the script and the assets an author supplied are worth committing.
output/
projects/*/audio/
# NOT projects/*/manim_code/ wholesale: the scene file for a hand-built video is
# SOURCE, not build output — it is written once and edited by hand, and losing it
# means rebuilding the whole animation. Only the composed file is generated
# (scene + inlined manim_helpers under a generated header), so only that is
# ignored. See tools/recompose.py.
projects/*/manim_code/*_composed.py
projects/*/manim_code/segment_*.py
projects/*/manim_code/__pycache__/
projects/*/media/
projects/*/work/
projects/*/final/
projects/*/qc/
projects/*/avatar/*.mp4
projects/*/avatar/*.mov
projects/*/avatar/*.webm
projects/*/assets/_cache/
media/

*.mp4
*.mp3
*.wav
!projects/*/assets/**

# THE SOUND LIBRARY IS COMMITTED (assets/sfx/README.md). It used to be ignored
# as "synthesized locally, deterministic" — but the live sounds are now supplied
# recordings and curated picks (the page swoosh, the camera shutter), which
# nothing can regenerate. Only the synth defaults src/sfx.py rebuilds on demand,
# and the rejected files, stay out.
!assets/sfx/**/*.wav
assets/sfx/_rejected/*.wav
assets/sfx/*.bak
assets/sfx/pop.wav
assets/sfx/ding.wav
assets/sfx/click.wav
assets/sfx/write.wav
assets/sfx/reveal.wav

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
projects/*/avatar/briefs/
.usage/
pricing.json

# Local drop folder. Source material lives on the machine that has it — the four
# 8K background plates alone are 130 MB. The README explains what goes here.
inbox/*
!inbox/README.md
!inbox/.gitkeep

# Generated anchor frames. Their prompts are model-written, so these are not
# reproducible byte-for-byte, but they are cached locally (frames/prompts.json)
# and cost a few cents to remake — not worth 15 MB of history.
projects/*/frames/*.png
projects/*/frames_hi/*.png
projects/*/aiclips/test_*/

# Rendered Manim output — regenerated from the scene + script, and a single
# 1080x1920 part is several MB.
projects/*/media/videos/

# Local interpreters for the avatar-synced track (see tools/README.md).
# Kept in the repo dir rather than the scratchpad, which gets wiped between
# sessions and took the whole manim install with it once.
.venv-manim/
.venv-tools/

# EndScreenshot build output. The generated pages and the cached temp sheets
# are regenerated from content/ + assets/, so only those two are worth keeping.
EndScreenshot/out/

# --- Secrets: never commit anything that can carry a credential ---------------
# Broadened beyond a bare `.env` so variants (.env.local, .env.production,
# api.env, direnv, service-account JSON, private keys) cannot slip through.
.env
.env.*
*.env
!.env.example
!.env.sample
!.env.template
.envrc
secrets.json
credentials.json
service-account*.json
*.pem
*.p12
*.pfx
id_rsa*

# Generated Veo clips and the frames the visual review sampled. Regenerated by
# `video veo`, and a single part can hold half a dozen rejected attempts — but
# clips_part<N>.json IS tracked, because it is the decision record: which clip
# went in, where, how it was fitted, and whether it passed.

# The edu-video renderer's dependencies and the ad-hoc backups a fix leaves
# behind. `out/` above already covers its 131 MB of rendered frames and video.
node_modules/
*.bak

# A separate product (the Hindi notes kit) that was bundled in here. It has no
# connection to the video pipeline and nothing in this repo references it; it
# stays on disk but out of the repo. Move it to its own home when convenient.
EndScreenshot/hindi-notes-kit/

# Manim's LaTeX caches. Regenerated on the first render that needs them.
texts/
Tex/
__pycache__/
.DS_Store

# Divider assets are DERIVED from assets/dividers/paper_tear_texture.jpg by
# tools/make_tear.py, keyed by the seam they are cut for. src/panel_layout.py
# builds whichever one a panel needs on first use, so they are build output.
assets/dividers/paper_tear_[0-9]*.png
assets/dividers/paper_tear_[0-9]*.json
assets/dividers/panel_fade_[0-9]*.png
map_engine/data/natural_earth/
map_engine/output/
map_engine/cache/
map_engine/node_modules

# Veo character kit: generated clips are build output, and the contact sheets
# make_refset.py writes beside the references are for looking at, not keeping.
veo_kit/example/*/clips/
assets/character/**/_sheet.png
assets/character/**/_chest_*.png

# --- Arts kit libraries (lab/kit_test) -----------------------------------------
# The sound library and the music beds ARE committed: the compositor mixes them
# and a render fails without them.  EXCEPT the files sourced from Mixkit: this repo
# is public, and Mixkit's licence allows using them in videos but not
# redistributing the files.  Run `.venv-tools/bin/python tools/fetch_mixkit.py`
# after cloning; it downloads each one from Mixkit and cuts it exactly as the
# manifest records (checked: all 75 rebuild identically).  Generated list; rerun
# the snippet in tools/fetch_mixkit.py's docstring if the manifests change.
!library/sfx/**/*.wav
!library/music/**/*.mp3
library/music/curious-underscore/little-bells.mp3
