# Scratch and staging folders, not videos
projects/_scratch/
projects/_la_check/
lab/kit_test/out/

# A project's Veo prompts and shot list ARE worth keeping (the clips are not)
projects/*/veo/*
!projects/*/veo/prompts/
!projects/*/veo/shots.json

# Kit reels (26 Oct 2026). projects/<slug>/ keeps INPUTS only: meta, captions, prompts, shots, papers, answer
# pages. Review pages, frame sheets, plan exports, caption backups and Veo working files are build output.
# Veo clips are not committed (about 3 MB each, and only re-fetchable while the Flow project lives).
projects/*/review/
projects/*/*frames*.jpg
projects/*/PLAN.*
projects/*/lines_part*.*.json
projects/*/veo/_tiles/
projects/*/veo/clips/
projects/*/veo/clean/
projects/*/veo/contact.jpg
projects/*/veo/submitted.json
projects/*/diagrams/*.mp4
lab/kit_test/plan_zz_*.json
CLEANUP_PLAN.md
RESUME.md

