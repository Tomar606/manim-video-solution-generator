# Environment
.env
venv/
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Build output. Everything under projects/ is regenerated from script.md, so
# only the script and the assets an author supplied are worth committing.
output/
projects/*/audio/
# NOT projects/*/manim_code/ wholesale: the scene file for a hand-built video is
# SOURCE, not build output — it is written once and edited by hand, and losing it
# means rebuilding the whole animation. Only the composed file is generated
# (scene + inlined manim_helpers under a generated header), so only that is
# ignored. See tools/recompose.py.
projects/*/manim_code/*_composed.py
projects/*/manim_code/segment_*.py
projects/*/manim_code/__pycache__/
projects/*/media/
projects/*/work/
projects/*/final/
projects/*/qc/
projects/*/avatar/*.mp4
projects/*/avatar/*.mov
projects/*/avatar/*.webm
projects/*/assets/_cache/
media/

# Sound effects are synthesized locally (video sfx) — deterministic, so there's
# nothing to gain from committing the binaries.
assets/sfx/

*.mp4
*.mp3
*.wav
!projects/*/assets/**

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
projects/*/avatar/briefs/
.usage/
pricing.json

# Local drop folder. Source material lives on the machine that has it — the four
# 8K background plates alone are 130 MB. The README explains what goes here.
inbox/*
!inbox/README.md
!inbox/.gitkeep

# Generated anchor frames. Their prompts are model-written, so these are not
# reproducible byte-for-byte, but they are cached locally (frames/prompts.json)
# and cost a few cents to remake — not worth 15 MB of history.
projects/*/frames/*.png
projects/*/frames_hi/*.png
projects/*/aiclips/test_*/

# Rendered Manim output — regenerated from the scene + script, and a single
# 1080x1920 part is several MB.
projects/*/media/videos/
