# Standalone answer-card renders. Cards written into a project's assets/ ARE
# tracked (they're an input to script.md's answer_image:) — this is only the
# scratch output dir used when `video answer` runs without a project.
out/

# Environment
.env
venv/
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Build output. Everything under projects/ is regenerated from script.md, so
# only the script and the assets an author supplied are worth committing.
output/
projects/*/audio/
# NOT projects/*/manim_code/ wholesale: the scene file for a hand-built video is
# SOURCE, not build output — it is written once and edited by hand, and losing it
# means rebuilding the whole animation. Only the composed file is generated
# (scene + inlined manim_helpers under a generated header), so only that is
# ignored. See tools/recompose.py.
projects/*/manim_code/*_composed.py
projects/*/manim_code/segment_*.py
projects/*/manim_code/__pycache__/
projects/*/media/
projects/*/work/
projects/*/final/
projects/*/qc/
projects/*/avatar/*.mp4
projects/*/avatar/*.mov
projects/*/avatar/*.webm
projects/*/assets/_cache/
media/

# Sound effects are synthesized locally (video sfx) — deterministic, so there's
# nothing to gain from committing the binaries.
assets/sfx/

*.mp4
*.mp3
*.wav
!projects/*/assets/**

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
projects/*/avatar/briefs/
.usage/
pricing.json

# Local drop folder. Source material lives on the machine that has it — the four
# 8K background plates alone are 130 MB. The README explains what goes here.
inbox/*
!inbox/README.md
!inbox/.gitkeep

# Generated anchor frames. Their prompts are model-written, so these are not
# reproducible byte-for-byte, but they are cached locally (frames/prompts.json)
# and cost a few cents to remake — not worth 15 MB of history.
projects/*/frames/*.png
projects/*/frames_hi/*.png
projects/*/aiclips/test_*/

# Rendered Manim output — regenerated from the scene + script, and a single
# 1080x1920 part is several MB.
projects/*/media/videos/

# Local interpreters for the avatar-synced track (see tools/README.md).
# Kept in the repo dir rather than the scratchpad, which gets wiped between
# sessions and took the whole manim install with it once.
.venv-manim/
.venv-tools/

# EndScreenshot build output. The generated pages and the cached temp sheets
# are regenerated from content/ + assets/, so only those two are worth keeping.
EndScreenshot/out/

# --- Secrets: never commit anything that can carry a credential ---------------
# Broadened beyond a bare `.env` so variants (.env.local, .env.production,
# api.env, direnv, service-account JSON, private keys) cannot slip through.
.env
.env.*
*.env
!.env.example
!.env.sample
!.env.template
.envrc
secrets.json
credentials.json
service-account*.json
*.pem
*.p12
*.pfx
id_rsa*

# Generated Veo clips and the frames the visual review sampled. Regenerated by
# `video veo`, and a single part can hold half a dozen rejected attempts — but
# clips_part<N>.json IS tracked, because it is the decision record: which clip
# went in, where, how it was fitted, and whether it passed.
projects/*/veo/

# The edu-video renderer's dependencies and the ad-hoc backups a fix leaves
# behind. `out/` above already covers its 131 MB of rendered frames and video.
node_modules/
*.bak
