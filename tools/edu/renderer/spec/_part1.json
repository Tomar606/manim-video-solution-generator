[
 {
  "seg_id": 1,
  "duration": 5.8,
  "voiceover": "कि बर्कले और हार्टले विधि समझ भी जाओ, याद भी कर लो और परीक्षा में लिखना भी सीख जाओ।",
  "phrases": [
   {
    "text": "कि बर्कले और हार्टले विधि समझ भी जाओ,",
    "golden": "हार्टले",
    "t_in": 0.0,
    "t_out": 2.76
   },
   {
    "text": "याद भी कर लो और परीक्षा में लिखना भी सीख जाओ।",
    "golden": null,
    "t_in": 2.96,
    "t_out": 5.8
   }
  ],
  "type": "TEXT_ONLY"
 },
 {
  "seg_id": 2,
  "duration": 4.9,
  "voiceover": "सबसे पहले समझते हैं, बर्कले एवं हार्टले की विधि में परासरण दाब कैसे मापा जाता है।",
  "phrases": [
   {
    "text": "सबसे पहले समझते हैं बर्कले एवं हार्टले की विधि में परासरण दाब कैसे मापा जाता है।",
    "golden": "परासरण",
    "t_in": 0.0,
    "t_out": 4.9
   }
  ],
  "type": "TEXT_ONLY"
 },
 {
  "seg_id": 3,
  "duration": 6.2,
  "voiceover": "और बच्चों, यहाँ से ध्यान से सुनना, क्योंकि परीक्षा में भी इसी तरह लिखने के नम्बर मिलते हैं।",
  "phrases": [
   {
    "text": "और बच्चों, यहाँ से ध्यान से सुनना,",
    "golden": null,
    "t_in": 0.0,
    "t_out": 2.5
   },
   {
    "text": "क्योंकि परीक्षा में भी इसी तरह लिखने के नम्बर मिलते हैं।",
    "golden": null,
    "t_in": 2.7,
    "t_out": 6.2
   }
  ],
  "type": "TEXT_ONLY"
 },
