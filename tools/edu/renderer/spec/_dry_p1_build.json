[
 {
  "seg_id": 1,
  "duration": 7.1,
  "voiceover": "रेडियो, खिलौने, कैलकुलेटर आदि में किया जाता है। ये सेल लेकलांशी सेल के सिद्धान्त पर",
  "phrases": [
   {
    "text": "रेडियो, खिलौने, कैलकुलेटर आदि में किया जाता है।",
    "golden": null,
    "t_in": 3.48,
    "t_out": 7.06
   },
   {
    "text": "ये सेल लेकलांशी सेल के सिद्धान्त पर",
    "golden": "लेकलांशी",
    "t_in": 7.06,
    "t_out": 7.1
   }
  ],
  "type": "TEXT_ONLY"
 },
 {
  "seg_id": 2,
  "duration": 7.1,
  "voiceover": "कार्य करता है, जिसका आविष्कार जी लेकलांशी ने 1868 में किया था।",
  "phrases": [
   {
    "text": "कार्य करता है, जिसका आविष्कार जी लेकलांशी",
    "golden": "लेकलांशी",
    "t_in": 2.36,
    "t_out": 5.14
   },
   {
    "text": "ने 1868 में किया था।",
    "golden": null,
    "t_in": 5.14,
    "t_out": 7.1
   }
  ],
  "type": "TEXT_ONLY"
 },
 {
  "seg_id": 3,
  "duration": 5.0,
  "voiceover": "अब आगे वाली बात दिमाग में बिठा लो, क्योंकि यही सबसे ज़रूरी है। शुष्क सेल में जिंक का एक खोखला",
  "phrases": [
   {
    "text": "अब आगे वाली बात दिमाग में बिठा लो,",
    "golden": null,
    "t_in": 0.04,
    "t_out": 2.64
   },
   {
    "text": "क्योंकि यही सबसे ज़रूरी है।",
    "golden": null,
    "t_in": 2.64,
    "t_out": 4.98
   },
   {
    "text": "शुष्क सेल में जिंक का एक खोखला",
    "golden": "जिंक",
    "t_in": 4.98,
    "t_out": 5.0
   }
  ],
  "type": "TEXT_ONLY"
 },
 {
  "seg_id": 4,
  "duration": 6.5,
  "voiceover": "आवरण होता है। यही जिंक का आवरण ऐनोड का काम करता है। इसके अंदर NH₄Cl और थोड़ी मात्रा में ZnCl₂ का",
  "phrases": [
   {
    "text": "आवरण होता है। यही जिंक का आवरण",
